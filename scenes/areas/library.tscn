[node name="Book1" type="Node3D" parent="Features" unique_id=2075587546]
transform = Transform3D(0.9800666, 0, -0.19866933, 0, 1, 0, 0.19866933, 0, 0.9800666, -3.1000001, 0.77, -1.4)
script = ExtResource("7_x6pmr")
pages = PackedStringArray("Chapter One: *Locking On*. Hold Z to face your foe. With a foe in your sights, the stick steps, circles and backs away.", "While targeting, press A to leap and strike from above: the *jump slash*! It hits twice as hard as a swing.", "Press A with the stick to the side to hop out of the way, or back to flip backward. Even in the middle of a hop, B turns it into a jump slash!")
title = "A Knight's Handbook"

[node name="Mesh" type="MeshInstance3D" parent="Features/Book1" unique_id=1777385855]
mesh = SubResource("ArrayMesh_nn1ca")

[node name="Book2" type="Node3D" parent="Features" unique_id=1749212313]
transform = Transform3D(0.9800666, 0, 0.19866933, 0, 1, 0, -0.19866933, 0, 0.9800666, 3.7, 0.77, -1.4)
script = ExtResource("7_x6pmr")
pages = PackedStringArray("Hold your shield without targeting and you will crouch behind it, feet planted. Target a foe and you can raise it and still move.", "The *Wooden Shield* stops arrows and claws, but heavy blows go straight through it. An *Iron Shield* stops even those.", "They say a polished *Silvered Shield* throws every shot back at whoever loosed it.")
title = "Shields of Haven"

[node name="Mesh" type="MeshInstance3D" parent="Features/Book2" unique_id=1261740316]
mesh = SubResource("ArrayMesh_urwkt")

[node name="Book3" type="Node3D" parent="Features" unique_id=1032801840]
transform = Transform3D(0.9800666, 0, -0.19866933, 0, 1, 0, 0.19866933, 0, 0.9800666, -3.1000001, 0.77, 1.6)
script = ExtResource("7_x6pmr")
pages = PackedStringArray("Deep water is no danger to a knight who can swim! Wade in and you will float. Push the stick to swim.", "Press A to dive under. You can\'t stay down for long, so come up for air!", "A knight cannot swing a sword while swimming. Climb out where the bank is low.")
title = "Swimming for Beginners"

[node name="Mesh" type="MeshInstance3D" parent="Features/Book3" unique_id=19106851]
mesh = SubResource("ArrayMesh_gtfev")

[node name="Book4" type="Node3D" parent="Features" unique_id=1576479474]
transform = Transform3D(0.9800666, 0, 0.19866933, 0, 1, 0, -0.19866933, 0, 0.9800666, 3.7, 0.77, 1.6)
script = ExtResource("7_x6pmr")
pages = PackedStringArray("The farm in the *Southern Fields* keeps fine horses. A horse that trusts you will come running for a *Sugar Cube*.", "Walk up to a horse and press A to mount. Push the stick to ride, and press A to spur her on. A spur needs a moment to come back.", "Horses jump low fences on their own. Ride out on the open fields: they will not follow you into towns or forests.")
title = "Horses of the Southern Fields"

[node name="Mesh" type="MeshInstance3D" parent="Features/Book4" unique_id=313848000]
mesh = SubResource("ArrayMesh_mcexc")

[node name="Book5" type="Node3D" parent="Features" unique_id=210918721]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, 0.98)
script = ExtResource("7_x6pmr")
pages = PackedStringArray("Haven is a green land in the world of *Bunsriel*. At its heart lie the wide *Bunsriel Fields*, and every road in Haven leads there.", "North stands *Old Castle Town* and the castle. North-west, the *Forest*, and past its stone gate the *Hidden Forest*, where few have walked.", "West lie the *Marshlands*, east the *Desert of Ladhellin*, and in the north-east the *Cliffs* climb toward the snows of *Frostpeak*.", "South, past the farms of the *Southern Fields* and our own *Haven Village*, the *South Road* winds to *Mirror Lake*.", "Old towers and shrines stand all over Haven. Their doors have been sealed for longer than anyone remembers.", "Hearts, they say, can be found in pieces, tucked into high and hidden places. Four pieces make a whole heart.")
title = "The Book of Haven"

[node name="Mesh" type="MeshInstance3D" parent="Features/Book5" unique_id=2033499713]
mesh = SubResource("ArrayMesh_qxl4c")

