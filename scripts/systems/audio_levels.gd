const AMBIENCE := {
	"amb_lake": -1.0,  # -16.0 LUFS
}


## The gain for music track `track` (a file name in assets/music).
static func music(track: String) -> float:
	return float(MUSIC.get(track, 0.0))


## The gain for ambience loop `id` (amb_*).
static func ambience(id: String) -> float:
	return float(AMBIENCE.get(id, 0.0))
