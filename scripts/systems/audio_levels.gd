class_name AudioLevels
extends RefCounted
## Per-track gain (dB) that brings every music track and ambience loop to
## one loudness (Beta 1.7.0 mix pass). Generated by
## _giggle64_work/tools/measure_levels.py --write from EBU R128 measurements:
## music aims at the median track (-23.8 LUFS) and ambience at -17 LUFS,
## each within +-6 dB and never past -1 dB true peak.
## Re-run it when a track is added or re-rendered.

const MUSIC := {
	"age_of_enlightenment": -6.0,  # -14.3 LUFS, peak 0.1 dBFS
	"ashwick": 3.7,  # -27.5 LUFS, peak -15.6 dBFS
