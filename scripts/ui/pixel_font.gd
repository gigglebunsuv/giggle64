class_name PixelFont
extends RefCounted
## A tiny built-in 5x7 bitmap font drawn with rectangles, so all UI text is
## pixel-exact at the 320x240 logical resolution with no external font files.

const W := 5
const H := 7
const ADVANCE := 6

