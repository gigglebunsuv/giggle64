## Lower-case letters for text boxes (draw_mixed). Eight rows: the x-height is
## rows 2-6 on the capitals' baseline, and row 7 holds descenders.
const LOWER := {
	"a": [".....", ".....", ".###.", "....#", ".####", "#...#", ".####", "....."],
	"b": ["#....", "#....", "####.", "#...#", "#...#", "#...#", "####.", "....."],
	"c": [".....", ".....", ".###.", "#....", "#....", "#...#", ".###.", "....."],
	"d": ["....#", "....#", ".####", "#...#", "#...#", "#...#", ".####", "....."],
	"e": [".....", ".....", ".###.", "#...#", "#####", "#....", ".###.", "....."],
	"f": ["..##.", ".#...", ".#...", "###..", ".#...", ".#...", ".#...", "....."],
	"g": [".....", ".....", ".####", "#...#", "#...#", ".####", "....#", ".###."],
	"h": ["#....", "#....", "####.", "#...#", "#...#", "#...#", "#...#", "....."],
	"i": ["..#..", ".....", ".##..", "..#..", "..#..", "..#..", ".###.", "....."],
	"j": ["...#.", ".....", "..##.", "...#.", "...#.", "...#.", "#..#.", ".##.."],
	"k": ["#....", "#....", "#..#.", "#.#..", "##...", "#.#..", "#..#.", "....."],
	"l": [".##..", "..#..", "..#..", "..#..", "..#..", "..#..", ".###.", "....."],
	"m": [".....", ".....", "##.#.", "#.#.#", "#.#.#", "#.#.#", "#...#", "....."],
	"n": [".....", ".....", "####.", "#...#", "#...#", "#...#", "#...#", "....."],
	"o": [".....", ".....", ".###.", "#...#", "#...#", "#...#", ".###.", "....."],
	"p": [".....", ".....", "####.", "#...#", "#...#", "####.", "#....", "#...."],
	"q": [".....", ".....", ".####", "#...#", "#...#", ".####", "....#", "....#"],
	"r": [".....", ".....", "#.##.", "##..#", "#....", "#....", "#....", "....."],
	"s": [".....", ".....", ".####", "#....", ".###.", "....#", "####.", "....."],
	"t": [".#...", ".#...", "###..", ".#...", ".#...", ".#..#", "..##.", "....."],
	"u": [".....", ".....", "#...#", "#...#", "#...#", "#..##", ".##.#", "....."],
	"v": [".....", ".....", "#...#", "#...#", "#...#", ".#.#.", "..#..", "....."],
	"w": [".....", ".....", "#...#", "#...#", "#.#.#", "#.#.#", ".#.#.", "....."],
	"x": [".....", ".....", "#...#", ".#.#.", "..#..", ".#.#.", "#...#", "....."],
	"y": [".....", ".....", "#...#", "#...#", "#...#", ".####", "....#", ".###."],
	"z": [".....", ".....", "#####", "...#.", "..#..", ".#...", "#####", "....."],
	"\"": [".#.#.", ".#.#.", ".....", ".....", ".....", ".....", "....."],
	";": [".....", ".##..", ".##..", ".....", ".##..", "..#..", ".#..."],
	"~": [".....", ".....", ".....", ".#..#", "#.##.", ".....", "....."],
	"&": [".##..", "#..#.", ".##..", ".#...", "#.#.#", "#..#.", ".##.#"],
}


static func measure(text: String, scale := 1) -> Vector2:
	return Vector2(maxi(text.length() * ADVANCE - 1, 0), H) * scale


## Draws `text` with its top-left at `pos`. Lower-case letters render as capitals.
static func draw(ci: CanvasItem, pos: Vector2, text: String, color: Color, scale := 1, shadow := true) -> void:
	if shadow:
		_draw_run(ci, pos + Vector2(scale, scale), text, Color(0, 0, 0, color.a * 0.85), scale)
	_draw_run(ci, pos, text, color, scale)


static func draw_centered(ci: CanvasItem, center_x: float, y: float, text: String, color: Color, scale := 1, shadow := true) -> void:
	var w := measure(text, scale).x
	draw(ci, Vector2(floorf(center_x - w * 0.5), y), text, color, scale, shadow)


## Breaks `text` (case kept) into lines no wider than `w` pixels.
static func wrap(text: String, w: float) -> Array:
	var out: Array = []
	var line := ""
	for word in text.split(" ", false):
		var trial := word if line == "" else line + " " + word
		if measure(trial).x > w and line != "":
			out.append(line)
			line = word
		else:
			line = trial
	if line != "":
		out.append(line)
	return out


## Draws mixed-case text (text boxes): lower-case letters keep their own glyphs.
static func draw_mixed(ci: CanvasItem, pos: Vector2, text: String, color: Color, shadow := true) -> void:
	if shadow:
		_draw_run(ci, pos + Vector2(1, 1), text, Color(0, 0, 0, color.a * 0.85), 1, true)
	_draw_run(ci, pos, text, color, 1, true)


static func _draw_run(ci: CanvasItem, pos: Vector2, text: String, color: Color, scale: int, mixed := false) -> void:
	var x := pos.x
	for ch in (text if mixed else text.to_upper()):
		var g: Array = LOWER[ch] if mixed and LOWER.has(ch) else GLYPHS.get(ch, [])
		for row in g.size():
			var line: String = g[row]
			for col in W:
				if line[col] == "#":
					ci.draw_rect(Rect2(x + col * scale, pos.y + row * scale, scale, scale), color)
		x += ADVANCE * scale


## Draws a small bitmap pattern (rows of '#', 'o' = outline color, '.' = empty).
static func draw_pattern(ci: CanvasItem, pos: Vector2, rows: Array, fill: Color, outline := Color(0, 0, 0, 0), scale := 1) -> void:
	for r in rows.size():
		var line: String = rows[r]
		for c in line.length():
			var ch := line[c]
			if ch == "#":
				ci.draw_rect(Rect2(pos.x + c * scale, pos.y + r * scale, scale, scale), fill)
			elif ch == "o" and outline.a > 0.0:
				ci.draw_rect(Rect2(pos.x + c * scale, pos.y + r * scale, scale, scale), outline)
