	"?": [".###.", "#...#", "....#", "...#.", "..#..", ".....", "..#.."],
	"-": [".....", ".....", ".....", ".###.", ".....", ".....", "....."],
	"'": ["..#..", "..#..", ".#...", ".....", ".....", ".....", "....."],
