func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	set_anchors_preset(Control.PRESET_FULL_RECT)
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	visible = false
	for i in PAGE_COUNT:
		var a := TAU * i / PAGE_COUNT
		page_dirs.append(Vector2(sin(a), -cos(a)))
	for i in PAGE_COUNT:
		var vp := SubViewport.new()
		vp.name = "Page%d" % i
		vp.size = PAGE_SIZE
		vp.transparent_bg = true
		vp.disable_3d = true
		vp.canvas_item_default_texture_filter = Viewport.DEFAULT_CANVAS_ITEM_TEXTURE_FILTER_NEAREST
		vp.render_target_update_mode = SubViewport.UPDATE_DISABLED
		var p := PageView.new()
		p.menu = self
		p.index = i
		p.size = Vector2(PAGE_SIZE)
		# Item pictures are smooth (they carry mipmaps); maps stay crisp.
		if i == Page.ITEM or i == Page.EQUIP:
			p.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
		vp.add_child(p)
		add_child(vp)
		_pages.append(vp)
	_eye = -page_dirs[page] * EYE_DIST
	_make_portrait()


## A little stage with the hero on it, drawn on the EQUIPMENT page.
func _make_portrait() -> void:
	_portrait = SubViewport.new()
	_portrait.name = "Portrait"
	_portrait.size = PORTRAIT_SIZE * 2
	_portrait.own_world_3d = true
	_portrait.transparent_bg = true
	_portrait.msaa_3d = Viewport.MSAA_4X
	_portrait.render_target_update_mode = SubViewport.UPDATE_DISABLED
	add_child(_portrait)
	var env := Environment.new()
	env.background_mode = Environment.BG_CLEAR_COLOR
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_color = Color(0.55, 0.55, 0.62)
	var we := WorldEnvironment.new()
	we.environment = env
	_portrait.add_child(we)
	var key := DirectionalLight3D.new()
	key.rotation = Vector3(deg_to_rad(-35), deg_to_rad(-30), 0)
	key.light_energy = 1.1
	_portrait.add_child(key)
	_portrait_model = load("res://assets/models/sir_gigglebuns.tscn").instantiate() as CharacterModel
	_portrait.add_child(_portrait_model)
	_portrait_model.set_sword_drawn(false)
	var cam := Camera3D.new()
	cam.fov = 30.0
	_portrait.add_child(cam)
	cam.look_at_from_position(Vector3(0, 1.1, -4.4), Vector3(0, 0.95, 0), Vector3.UP)
	cam.current = true


# --- Opening, closing, flipping -------------------------------------------------

func _open() -> void:
	phase = Phase.OPENING
	_t = 0.0
	save_prompt = 0
	map_cursor = WorldData.map_area(World.area_id)
	map_zoom = false
	if is_instance_valid(GameManager.player):
		map_floor = World.floor_at(GameManager.player.global_position.y)
	if sub_list != "":
		option_cursor = OPTIONS.find(sub_list)
		sub_list = ""
	edge = 0
	quest_tree = false
	_option_scroll = 0
	_eye = -page_dirs[page] * EYE_DIST
	Sfx.play("menu_select", -4.0)


func _close() -> void:
	if phase == Phase.CLOSING or phase == Phase.CLOSED:
		return
	phase = Phase.CLOSING
	_t = 0.0
	Sfx.play("menu_select", -6.0)


func _flip(right: bool) -> void:
	if phase != Phase.OPEN:
		return
	_next_page = ((page + (1 if right else PAGE_COUNT - 1)) % PAGE_COUNT) as Page
	# KaleidoScope_SetupPageSwitch: the cursor arrives on the new page's button
	# on the side it came from.
	_arrive_edge = -1 if right else 1
	quest_tree = false
	_eye_from = _eye
	phase = Phase.SWITCHING
	_t = 0.0
	map_zoom = false
	Sfx.play("menu_move", -3.0)


func _process(delta: float) -> void:
	var state := GameManager.state
	_blink += delta
	_equip_flash += delta
	if phase == Phase.CLOSED:
		if state == GameManager.GameState.PLAYING and Input.is_action_just_pressed("pause") and not World.transitioning and not Dialogue.active and not Cutscene.active and not DebugMenu.active and not DebugMenu.combo_held():
			GameManager.pause_game()
		if GameManager.state == GameManager.GameState.PAUSED:
			_open()
	elif state != GameManager.GameState.PAUSED and phase != Phase.CLOSING:
		# Resumed from elsewhere (a test, the warp): drop the screen at once.
		phase = Phase.CLOSED
	match phase:
		Phase.OPENING:
			_t += delta
			if _t >= OPEN_TIME:
				phase = Phase.OPEN
		Phase.CLOSING:
			_t += delta
			if _t >= CLOSE_TIME:
				phase = Phase.CLOSED
				GameManager.resume_game()
		Phase.SWITCHING:
			_t += delta
			var k := clampf(_t / SWITCH_TIME, 0.0, 1.0)
			_eye = _eye_from.lerp(-page_dirs[_next_page] * EYE_DIST, k)
			if k >= 1.0:
				page = _next_page
				phase = Phase.OPEN
				edge = _arrive_edge
				_edge_hold = -1.0
				_option_scroll = 0
		Phase.OPEN:
			_handle_input(delta)
			# The quest under the journal's cursor has been read.
			if page == Page.JOURNAL and edge == 0 and phase == Phase.OPEN:
				var known := Quests.known()
				if not known.is_empty():
					Progress.flags[quest_mark(known[clampi(journal_cursor, 0, known.size() - 1)])] = true
	var opening := phase == Phase.OPENING
	var closing := phase == Phase.CLOSING
	var k2 := clampf(_t / (OPEN_TIME if opening else CLOSE_TIME), 0.0, 1.0)
	_pitch = (1.0 - k2) * 80.0 if opening else (k2 * 80.0 if closing else 0.0)
	_alpha = k2 if opening else (1.0 - k2 if closing else 1.0)
	visible = phase != Phase.CLOSED
	for i in PAGE_COUNT:
		_pages[i].render_target_update_mode = SubViewport.UPDATE_ALWAYS if visible else SubViewport.UPDATE_DISABLED
		(_pages[i].get_child(0) as Control).queue_redraw()
	_portrait.render_target_update_mode = SubViewport.UPDATE_ALWAYS if visible else SubViewport.UPDATE_DISABLED
	if visible:
		# Whoever is being played (co-op's CHARACTER), in their own gear.
		if _portrait_model.scene_file_path != Net.model_path(Net.character):
			var m := (load(Net.model_path(Net.character)) as PackedScene).instantiate() as CharacterModel
			_portrait.remove_child(_portrait_model)
			_portrait_model.queue_free()
			_portrait.add_child(m)
			_portrait_model = m
			_portrait_model.set_sword_drawn(false)
		_portrait_model.set_gear(Equipment.sword_look(Progress.sword), Progress.shield)
		_portrait_model.set_boots(Progress.boot)
		_portrait_model.set_outfit(Progress.tunic, Progress.vanity_on)
		_portrait_turn += delta * 0.6
		_portrait_model.rotation.y = PI + sin(_portrait_turn) * 0.7
	if visible:
		queue_redraw()


# --- Input --------------------------------------------------------------------

func _handle_input(delta: float) -> void:
	if is_instance_valid(_entry):
		return
	if save_prompt != 0:
		_save_prompt_input(delta)
		return
	if remap_waiting != "":
		# Waiting for the new key or button (_input binds it); it gives up after a while.
		_remap_time -= delta
		if _remap_time <= 0.0:
			remap_waiting = ""
			Sfx.play("msg_close", -6.0)
		return
	if quest_tree:
		_tree_input(delta)
		return
	if Input.is_action_just_pressed("attack") and not (page == Page.OPTIONS and sub_list != ""):
		save_prompt = 1
		save_choice = 0
		Sfx.play("menu_select", -4.0)
		return
	if page == Page.OPTIONS and sub_list != "" and not Input.is_action_just_pressed("pause") 			and (Input.is_action_just_pressed("ui_cancel") or Input.is_action_just_pressed("attack")):
		_close_graphics()
		return
	if Input.is_action_just_pressed("pause") or Input.is_action_just_pressed("ui_cancel"):
		_close()
		return
	if Input.is_action_just_pressed("shield"):
		_flip(true)
		return
	if Input.is_action_just_pressed("target"):
		_flip(false)
		return
	var dir := _cursor_dir(delta)
	if edge != 0:
		_edge_input(dir, delta)
		return
	if dir != Vector2i.ZERO:
		_move_cursor(dir)
	if page == Page.ITEM:
		for b in ["item_x", "item_y"]:
			if Input.is_action_just_pressed(b):
				_equip(b)
	if Input.is_action_just_pressed("ui_accept") or Input.is_action_just_pressed("interact"):
		_accept()


## A line of text typed in (the ONLINE page's NAME and ADDRESS): Enter
## keeps it, Escape leaves it as it was.
var _entry: LineEdit
var _entry_for := ""


func _open_entry(what: String, text: String) -> void:
	_entry_for = what
	_entry = LineEdit.new()
	_entry.text = text
	_entry.max_length = 40 if what == "ADDRESS" else 14
	_entry.alignment = HORIZONTAL_ALIGNMENT_CENTER
	_entry.add_theme_font_size_override("font_size", 14)
	_entry.size = Vector2(200, 24)
	_entry.position = Vector2(60, 108)
	# The pause screen's plates: deep blue, a gold rim, cream lettering.
	var box := StyleBoxFlat.new()
	box.bg_color = Color("1a2240")
	box.border_color = Color("d8b050")
	box.set_border_width_all(2)
	box.set_corner_radius_all(3)
	box.content_margin_left = 6
	box.content_margin_right = 6
	for state in ["normal", "focus"]:
		_entry.add_theme_stylebox_override(state, box)
	_entry.add_theme_color_override("font_color", Color("f4e8c8"))
	_entry.add_theme_color_override("caret_color", Color("f0c850"))
	_entry.placeholder_text = "ADDRESS OF THE HOST" if what == "ADDRESS" else "YOUR NAME"
	_entry.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_entry)
	_entry.grab_focus()
	_entry.caret_column = text.length()
	_entry.text_submitted.connect(_entry_done)


func _entry_done(text: String) -> void:
	text = text.strip_edges()
	if text != "":
		if _entry_for == "ADDRESS":
			Net.address = text
		else:
			Net.player_name = text.to_upper()
	_entry.queue_free()
	_entry = null
	Sfx.play("menu_select", -4.0)


## While a CONTROLS row waits, the next key, mouse button or gamepad button
## (or trigger) pressed becomes its binding.
func _input(event: InputEvent) -> void:
	if is_instance_valid(_entry) and event.is_action_pressed("ui_cancel"):
		_entry.queue_free()
		_entry = null
		get_viewport().set_input_as_handled()
		return
	if remap_waiting == "" or phase != Phase.OPEN:
		return
	var bindable: bool = (event is InputEventKey and event.pressed and not event.echo) or (event is InputEventJoypadButton and event.pressed) \
		or (event is InputEventMouseButton and event.pressed) or (event is InputEventJoypadMotion and absf(event.axis_value) > 0.7 and event.axis >= JOY_AXIS_TRIGGER_LEFT)
	if not bindable:
		return
	get_viewport().set_input_as_handled()
	GameManager.remap(remap_waiting, event)
	remap_waiting = ""
	# The press that bound it must not also act on the menu.
	_remap_time = 0.0
	Sfx.play("menu_select", -4.0)
	for a in InputMap.get_actions():
		Input.action_release(a)


## KaleidoScope_HandlePageToggles: on a page-turn button, the stick held
## toward it for EDGE_HOLD, or pushed toward it afresh, turns the page;
## pushed the other way, the cursor goes back onto the page.
func _edge_input(dir: Vector2i, delta: float) -> void:
	var held := _cursor.held()
	if held.x == edge:
		if _edge_hold < 0.0:
			_edge_hold = 0.0
			_flip(edge > 0)
			return
		_edge_hold += delta
		if _edge_hold >= EDGE_HOLD:
			_flip(edge > 0)
		return
	_edge_hold = -1.0
	if dir.x == -edge and dir.x != 0:
		_enter_page(edge)


## KaleidoScope_MoveCursorToSpecialPos: the cursor stops on the page-turn
## button on `side` (NA_SE_SY_DECIDE).
func _to_edge(side: int) -> void:
	edge = side
	_edge_hold = 0.0
	Sfx.play("menu_select", -8.0)


## Back onto the page from the button on `side`: the first slot from that side
## (SELECT ITEM and EQUIPMENT scan the columns from that edge, as OoT does).
func _enter_page(side: int) -> void:
	edge = 0
	match page:
		Page.ITEM:
			var cols: Array = range(ITEM_COLS) if side < 0 else range(ITEM_COLS - 1, -1, -1)
			var found := false
			for x: int in cols:
				for y in ITEM_ROWS:
					if _item_owned(Vector2i(x, y)):
						item_cursor = Vector2i(x, y)
						found = true
						break
				if found:
					break
			if not found:
				# Nothing to stand on: over to the other side's button.
				_to_edge(-side)
				return
		Page.EQUIP:
			var row := equip_cursor.y
			if row != UPGRADE_ROW:
				var n := equip_cols(row)
				var xs: Array = range(n) if side < 0 else range(n - 1, -1, -1)
				for x: int in xs:
					if gear_owned(row, (EQUIP_ROWS[row] as Array)[x]):
						equip_cursor.x = x
						break
			else:
				equip_cursor.x = 0 if side < 0 else UPGRADES.size() - 1
		Page.QUEST:
			var best := quest_cursor
			for i in QUEST_SLOTS.size():
				var x: float = (QUEST_SLOTS[i][1] as Vector2).x
				var bx: float = (QUEST_SLOTS[best][1] as Vector2).x
				if (side < 0 and x < bx) or (side > 0 and x > bx):
					best = i
			quest_cursor = best
	Sfx.play("menu_move", -8.0)


func _item_owned(c: Vector2i) -> bool:
	var i := c.y * ITEM_COLS + c.x
	return i < Progress.ITEM_GRID.size() and Progress.has_item(Progress.ITEM_GRID[i])


## The JOURNAL's quest tree: up and down scroll it, B (or A) goes back to the
## list, START closes the pause screen.
func _tree_input(delta: float) -> void:
	if Input.is_action_just_pressed("pause"):
		quest_tree = false
		_close()
		return
	if Input.is_action_just_pressed("attack") or Input.is_action_just_pressed("ui_cancel") \
			or Input.is_action_just_pressed("interact") or Input.is_action_just_pressed("ui_accept"):
		quest_tree = false
		Sfx.play("msg_close", -6.0)
		return
	var d := _cursor_dir(delta)
	if d.y != 0:
		var most := maxi(tree_rows().size() - TREE_ROWS, 0)
		var to := clampi(tree_scroll + d.y, 0, most)
		if to != tree_scroll:
			tree_scroll = to
			Sfx.play("menu_move", -8.0)


func _save_prompt_input(delta: float) -> void:
	if save_prompt == 2:
		_saved_time -= delta
		if _saved_time <= 0.0 or Input.is_action_just_pressed("interact") or Input.is_action_just_pressed("attack"):
			save_prompt = 0
		return
	var d := _cursor_dir(delta)
	if d.y != 0 or d.x != 0:
		save_choice ^= 1
		Sfx.play("menu_move", -6.0)
	if Input.is_action_just_pressed("attack") or Input.is_action_just_pressed("ui_cancel") or Input.is_action_just_pressed("pause"):
		save_prompt = 0
		Sfx.play("msg_close", -6.0)
	elif Input.is_action_just_pressed("ui_accept") or Input.is_action_just_pressed("interact"):
		if save_choice == 0:
			save_now()
		else:
			save_prompt = 0
			Sfx.play("msg_close", -6.0)


## Writes the game to its file (the first file if it has none yet).
func save_now() -> bool:
	var ok := SaveGame.save(Progress.slot if Progress.slot >= 0 else 0)
	save_prompt = 2
	_saved_time = 1.6
	Sfx.play("puzzle_solved" if ok else "error", -6.0)
	return ok


## Held-direction auto-repeat, like OoT's cursor (first step at once, then a
## short delay and a steady repeat).
func _cursor_dir(delta: float) -> Vector2i:
	return _cursor.step(delta)


## Where SELECT ITEM's slot `slot` (column, row) sits on the page.
func item_slot_centre(slot: Vector2i) -> Vector2:
	return Vector2(ITEM_SLOT_X + slot.x * ITEM_SLOT_STEP, ITEM_TRAY_Y + slot.y * ITEM_TRAY_STEP + ITEM_TRAY_H * 0.5)


## The item under the SELECT ITEM cursor, or "".
func item_at_cursor() -> String:
	var i := item_cursor.y * ITEM_COLS + item_cursor.x
	if i < Progress.ITEM_GRID.size() and Progress.has_item(Progress.ITEM_GRID[i]):
		return Progress.ITEM_GRID[i]
	return ""


## OoT equips the item under the cursor to whichever C button is pressed.
func _equip(button: String) -> void:
	var item := item_at_cursor()
	if item == "":
		Sfx.play("error", -6.0)
		return
	Progress.assign(button, item)
	_equip_flash_slot = item_cursor
	_equip_flash = 0.0
	Sfx.play("menu_select", -4.0)


func _move_cursor(d: Vector2i) -> void:
	match page:
		Page.ITEM:
			if not _move_item_cursor(d):
				return
		Page.EQUIP:
			var c := equip_cursor + d
			c.y = clampi(c.y, 0, UPGRADE_ROW)
			var cols := equip_cols(c.y)
			# Between the gear rows and the upgrades, keep to the nearest slot.
			if d.y != 0 and (c.y == UPGRADE_ROW) != (equip_cursor.y == UPGRADE_ROW):
				var x := equip_slot_centre(equip_cursor).x
				var best := 0
				for i in cols:
					if absf(equip_slot_centre(Vector2i(i, c.y)).x - x) < absf(equip_slot_centre(Vector2i(best, c.y)).x - x):
						best = i
				c.x = best
			if d.x != 0 and c.y != UPGRADE_ROW:
				# Along a gear row the cursor skips what he hasn't got (OoT's
				# equipment subscreen), and past the last one it stops on the
				# page-turn button.
				var x := equip_cursor.x + d.x
				while x >= 0 and x < cols and not gear_owned(c.y, (EQUIP_ROWS[c.y] as Array)[x]):
					x += d.x
				if x < 0 or x >= cols:
					_to_edge(d.x)
					return
				c.x = x
			if c.x < 0:
				_to_edge(-1)
				return
			if c.x >= cols:
				if d.x > 0:
					_to_edge(1)
					return
				c.x = cols - 1
			equip_cursor = c
		Page.MAP:
			# In a tower, up and down turn through its storeys (OoT's floor list).
			if World.dungeon_id() != "":
				if d.x != 0:
					_to_edge(d.x)
				elif World.floors().size() > 1:
					var f := clampi(map_floor - d.y, 0, World.floors().size() - 1)
					if f != map_floor:
						map_floor = f
						Sfx.play("menu_move", -6.0)
				return
			var next := _map_neighbour(map_cursor, Vector2(d))
			if next == "":
				if d.x != 0:
					_to_edge(d.x)
				return
			map_cursor = next
		Page.JOURNAL:
			var n := Quests.known().size()
			if d.x != 0:
				_to_edge(d.x)
				return
			if n == 0:
				return
			var to := clampi(journal_cursor + d.y, 0, n - 1)
			if to == journal_cursor:
				return
			journal_cursor = to
			if journal_cursor < _journal_scroll:
				_journal_scroll = journal_cursor
			elif journal_cursor >= _journal_scroll + JOURNAL_ROWS:
				_journal_scroll = journal_cursor - JOURNAL_ROWS + 1
		Page.QUEST:
			var best := -1
			var best_score := INF
			var from: Vector2 = QUEST_SLOTS[quest_cursor][1]
			for i in QUEST_SLOTS.size():
				var to: Vector2 = QUEST_SLOTS[i][1] - from
				if i == quest_cursor or to.normalized().dot(Vector2(d)) < 0.5:
					continue
				var score := to.length() * (2.0 - to.normalized().dot(Vector2(d)))
				if score < best_score:
					best_score = score
					best = i
			if best < 0:
				if d.x != 0:
					_to_edge(d.x)
				return
			quest_cursor = best
		Page.OPTIONS:
			if d.y != 0:
				option_cursor = wrapi(option_cursor + d.y, 0, options_list().size())
				_scroll_options()
			elif sound_open and slider_key(options_list()[option_cursor]) != "":
				nudge_slider(options_list()[option_cursor], d.x)
				return
			else:
				_to_edge(d.x)
				return
	Sfx.play("menu_move", -8.0)


## OoT's item cursor (KaleidoScope_UpdateItemCursor): sideways it runs on to
## the next item, skipping empty slots; with none left that way on the row it
## tries the rows below from where it started; with none at all it stops on
## the page-turn button. Up and down go to the next item in the column, if
## any. False when the cursor didn't move to a slot.
func _move_item_cursor(d: Vector2i) -> bool:
	if d.x != 0:
		var x := item_cursor.x
		var y := item_cursor.y
		for _guard in ITEM_COLS * ITEM_ROWS + ITEM_ROWS:
			if (d.x < 0 and x > 0) or (d.x > 0 and x < ITEM_COLS - 1):
				x += d.x
				if _item_owned(Vector2i(x, y)):
					item_cursor = Vector2i(x, y)
					return true
			else:
				x = item_cursor.x
				y = (y + 1) % ITEM_ROWS
				if y == item_cursor.y:
					break
		_to_edge(d.x)
		return false
	var yy := item_cursor.y + d.y
	while yy >= 0 and yy < ITEM_ROWS:
		if _item_owned(Vector2i(item_cursor.x, yy)):
			item_cursor.y = yy
			return true
		yy += d.y
	return false


## Keeps the OPTIONS cursor's row in view.
func _scroll_options() -> void:
	var n := options_list().size()
	if option_cursor < _option_scroll:
		_option_scroll = option_cursor
	elif option_cursor >= _option_scroll + OPTION_VISIBLE:
		_option_scroll = option_cursor - OPTION_VISIBLE + 1
	_option_scroll = clampi(_option_scroll, 0, maxi(n - OPTION_VISIBLE, 0))


## The world map's fog (Beta 1.6.0): a region shows once the hero has been
## anywhere in it (World sets "visited:<area>"; a dungeon or house counts for
## the region it lies in); the others stay under cloud.
static func region_seen(region: String) -> bool:
	if WorldData.map_area(World.area_id) == region:
		return true
	for k: String in Progress.flags:
		if k.begins_with("visited:") and Progress.flags[k] and WorldData.map_area(k.substr(8)) == region:
			return true
	return false


## The region whose box lies most nearly in direction `d` from `from`.
func _map_neighbour(from: String, d: Vector2) -> String:
	var c := WorldData.map_point(from)
	var best := ""
	var best_score := INF
	for area: String in WorldData.MAP_LAYOUT:
		if area == from or not region_seen(area):
			continue
		var to := WorldData.map_point(area) - c
		var cosang := to.normalized().dot(d)
		if cosang < 0.45:
			continue
		var score := to.length() * (2.2 - cosang)
		if score < best_score:
			best_score = score
			best = area
	return best


func _accept() -> void:
	match page:
		Page.MAP:
			map_zoom = not map_zoom
			Sfx.play("menu_select", -6.0)
		Page.JOURNAL:
			# The whole quest line of the one chosen.
			if Quests.known().is_empty():
				Sfx.play("error", -6.0)
				return
			quest_tree = true
			tree_scroll = 0
			# Open on the step to do now.
			var rows := tree_rows()
			for i in rows.size():
				if String(rows[i][0]) == "now":
					tree_scroll = clampi(i - 3, 0, maxi(rows.size() - TREE_ROWS, 0))
					break
			Sfx.play("menu_select", -4.0)
		Page.EQUIP:
			_equip_gear()
		Page.OPTIONS:
			Sfx.play("menu_select", -4.0)
			# A CONTROLS row waits for its new binding (before any main option of the same name acts).
			if sub_list == "CONTROLS" and GameManager.remap_label(String(options_list()[option_cursor])) != "":
				remap_waiting = GameManager.remap_label(String(options_list()[option_cursor]))
				_remap_time = 5.0
				return
			match options_list()[option_cursor]:
				"RESUME":
					_close()
				"GRAPHICS", "SOUND", "CONTROLS", "ONLINE":
					sub_list = options_list()[option_cursor]
					option_cursor = 0
					_option_scroll = 0
				"CHARACTER":
					var ci := Net.CHARACTERS.find(Net.character)
					Net.set_character(Net.CHARACTERS[(ci + 1) % Net.CHARACTERS.size()])
				"NAME":
					_open_entry("NAME", Net.display_name())
				"ADDRESS":
					_open_entry("ADDRESS", Net.address)
				"HOST GAME":
					if not Net.host():
						Sfx.play("error", -6.0)
				"JOIN GAME":
					if not Net.join():
						Sfx.play("error", -6.0)
				"PVP":
					if Net.is_client():
						Sfx.play("error", -6.0)
					else:
						Net.set_pvp(not Net.pvp)
				"LEAVE":
					Net.leave()
				"RESET DEFAULTS":
					GameManager.reset_controls()
				"OUTPUT":
					GameManager.toggle_mono()
				"PAUSE MUFFLE":
					GameManager.toggle_pause_muffle()
				"BACK":
					_close_graphics()
				"FRAME RATE":
					GameManager.cycle_frame_rate()
				"TRUE N64 MODE":
					GameManager.toggle_true_n64()
				"N64 MIPMAPS":
					if GameManager.true_n64:
						GameManager.toggle_n64_mipmaps()
					else:
						Sfx.play("error", -6.0)
				"RESOLUTION":
					if GameManager.true_n64:
						Sfx.play("error", -6.0)
					else:
						GameManager.cycle_resolution()
				"ASPECT RATIO":
					GameManager.toggle_widescreen()
				"HUD STYLE":
					GameManager.toggle_hud_style()
				"BUTTON ICONS":
					GameManager.cycle_glyphs()
				"ANTI-ALIASING":
					GameManager.toggle_smoothing()
				"FOG":
					GameManager.toggle_fog()
				"CROSSHAIR":
					GameManager.toggle_crosshair()
				"GUIDING LIGHT":
					GameManager.toggle_guide_beacon()
				"RUMBLE":
					GameManager.toggle_rumble()
				"LOCK-ON":
					GameManager.toggle_z_target_mode()
				"CAMERA":
					GameManager.toggle_camera_mode()
				"CAMERA SPEED":
					GameManager.cycle_camera_speed()
				"CAMERA X":
					GameManager.toggle_camera_invert_x()
				"CAMERA Y":
					GameManager.toggle_invert_look()
				"MINIMAP":
					GameManager.toggle_minimap()
				"FULLSCREEN":
					GameManager.toggle_fullscreen()
				"CREDITS":
					phase = Phase.CLOSED
					GameManager.resume_game()
					Story.credits_roll()
				"QUIT":
					GameManager.quit_game()


## How many slots an EQUIPMENT row has.
static func equip_cols(row: int) -> int:
	return UPGRADES.size() if row == UPGRADE_ROW else (EQUIP_ROWS[row] as Array).size()


## Where an EQUIPMENT slot sits on the page (the vanity outfit a little
## apart from the tunics).
static func equip_slot_centre(slot: Vector2i) -> Vector2:
	var y := EQUIP_TRAY_Y + slot.y * EQUIP_TRAY_STEP + EQUIP_TRAY_H * 0.5
	if slot.y == UPGRADE_ROW:
		return Vector2(UPGRADE_SLOT_X + slot.x * UPGRADE_SLOT_STEP, y)
	var x := EQUIP_SLOT_X + slot.x * EQUIP_SLOT_STEP
	if slot.y == TUNIC_ROW_INDEX and slot.x >= 4:
		x += VANITY_GAP
	return Vector2(x, y)


## An upgrade's look and level: {icon, owned, level (short), name, maxed}.
static func upgrade_info(id: String) -> Dictionary:
	match id:
		"quiver":
			return {"icon": "quiver", "owned": Progress.has_item("bow"), "level": str(Progress.arrows_max),
				"name": "QUIVER - %d ARROWS" % Progress.arrows_max, "maxed": Progress.arrows_max >= Progress.BIGGEST_QUIVER}
		"bomb_bag":
			return {"icon": "bomb_bag", "owned": Progress.bombs_max > 0, "level": str(Progress.bombs_max),
				"name": "BOMB BAG - %d BOMBS" % Progress.bombs_max, "maxed": Progress.bombs_max >= 40}
		"nut_pouch":
			return {"icon": "puff_nuts", "owned": Progress.nuts_max > 0, "level": str(Progress.nuts_max),
				"name": "NUT POUCH - %d NUTS" % Progress.nuts_max, "maxed": Progress.nuts_max >= 40}
		"wallet":
			return {"icon": "giant_wallet" if Progress.wallet >= Progress.GIANT_WALLET else ("big_wallet" if Progress.wallet > Progress.WALLET_SIZE else "rupee"), "owned": true, "level": str(Progress.wallet),
				"name": "WALLET - %d COINS" % Progress.wallet, "maxed": Progress.wallet >= Progress.GIANT_WALLET}
		"magic":
			var two := Progress.magic_max > Progress.MAGIC_SINGLE
			return {"icon": "magic", "owned": Progress.magic_max > 0, "level": "x2" if two else "x1",
				"name": "DOUBLE MAGIC" if two else "MAGIC METER", "maxed": two}
		"defense":
			return {"icon": "heart_container", "owned": Progress.defense > 1, "level": "x2",
				"name": "DOUBLE DEFENSE", "maxed": true}
		"bracers":
			return {"icon": "questlord_gauntlets" if Progress.bracers >= 2 else "bun_bracers", "owned": Progress.bracers > 0, "level": "L%d" % Progress.bracers,
				"name": Progress.BRACER_NAMES[clampi(Progress.bracers, 0, Progress.BRACER_NAMES.size() - 1)], "maxed": Progress.bracers >= Progress.BRACER_NAMES.size() - 1}
		"scale":
			var sc := clampi(Progress.scale, 0, Progress.SCALE_NAMES.size() - 1)
			return {"icon": "golden_scale" if sc >= 2 else "silver_scale", "owned": sc > 0, "level": "%dM" % int(Progress.dive_depth() * 0.03),
				"name": Progress.SCALE_NAMES[sc], "maxed": sc >= Progress.SCALE_NAMES.size() - 1}
	return {"icon": "", "owned": false, "level": "", "name": "", "maxed": false}


## The sword or shield under the EQUIPMENT cursor ("" for an empty slot).
func gear_at_cursor() -> String:
	if equip_cursor.y == UPGRADE_ROW:
		return ""
	var row: Array = EQUIP_ROWS[equip_cursor.y]
	var id: String = row[mini(equip_cursor.x, row.size() - 1)]
	return id if gear_owned(equip_cursor.y, id) else ""


static func gear_owned(row: int, id: String) -> bool:
	match row:
		0: return Progress.has_sword(id)
		1: return Progress.has_shield(id)
		2: return Progress.has_vanity(id) if Equipment.VANITY.has(id) else Progress.has_tunic(id)
	return Progress.has_boots(id)


static func gear_equipped(row: int) -> String:
	match row:
		0: return Progress.sword
		1: return Progress.shield
		2: return Progress.tunic
	return Progress.boot


## The piece in an EQUIPMENT slot is worn (a vanity outfit counts while on).
static func gear_worn(row: int, id: String) -> bool:
	if row == TUNIC_ROW_INDEX and Equipment.VANITY.has(id):
		return Progress.vanity_on == id
	return gear_equipped(row) == id


## The two short lines under the portrait about the piece under the cursor
## (or, on an empty slot, the one equipped in that row).
func equip_note() -> Array:
	var row := equip_cursor.y
	if row == UPGRADE_ROW:
		var up := upgrade_info(UPGRADES[equip_cursor.x])
		if not up.owned:
			return []
		match UPGRADES[equip_cursor.x]:
			"magic": return ["MAGIC", up.level]
			"defense": return ["DEFENSE", "x2"]
			"bracers": return ["PULLS", "GREAT STONES"] if Progress.bracers >= 2 else ["LIFTS", "BOULDERS"]
			"scale": return ["DIVES", up.level]
		return ["HOLDS", up.level]
	var id := gear_at_cursor()
	if id == "":
		id = gear_equipped(row)
	match row:
		0:
			var sw := Equipment.sword(id)
			return ["POWER %d" % int(sw.damage), "BEAM" if sw.get("beam", false) else ""]
		1:
			var sh := Equipment.shield(id)
			if sh.get("mirror", false):
				return ["REFLECTS", "SHOTS"]
			return ["BLOCKS", "HEAVY HITS"] if sh.get("heavy", false) else ["LIGHT", "AND QUICK"]
		2:
			if Equipment.VANITY.has(id):
				return ["VANITY", "WORN" if Progress.vanity_on == id else "PUT AWAY"]
			var tu := Equipment.tunic(id)
			if tu.get("breathe", false):
				return ["BREATHES", "UNDERWATER"]
			if tu.get("warm", false):
				return ["PROOF", "AGAINST COLD"]
			if tu.has("stealth"):
				return ["UNSEEN", "BY FOES"]
			return ["KNIGHT", "OF HAVEN"]
	var bt := Equipment.boots(id)
	return ["GLIDE", "WINDPROOF"] if bt.get("wind", false) else ["STURDY", ""]


## A equips the sword or shield under the cursor (KaleidoScope_UpdateEquipment).
func _equip_gear() -> void:
	if equip_cursor.y == UPGRADE_ROW:
		return
	var id := gear_at_cursor()
	if id == "":
		Sfx.play("error", -6.0)
		return
	match equip_cursor.y:
		0: Progress.equip_sword(id)
		1: Progress.equip_shield(id)
		2:
			if Equipment.VANITY.has(id):
				Progress.toggle_vanity(id)
			else:
				Progress.equip_tunic(id)
		_: Progress.equip_boots(id)
	Sfx.play("menu_select", -4.0)


## The rows the OPTIONS page shows now: the main list, GRAPHICS, SOUND or CONTROLS.
func options_list() -> Array:
	match sub_list:
		"GRAPHICS": return GRAPHICS_OPTIONS
		"SOUND": return SOUND_OPTIONS
		"CONTROLS": return GameManager.REMAP_ACTIONS.map(func(a: Array) -> String: return String(a[1])) + CONTROL_EXTRA
		"ONLINE": return ONLINE_OPTIONS
	return OPTIONS


## Back from GRAPHICS or SOUND to the main list.
func _close_graphics() -> void:
	option_cursor = maxi(OPTIONS.find(sub_list), 0)
	sub_list = ""
	_scroll_options()
	Sfx.play("menu_select", -6.0)


## The GameManager volume key behind a SOUND row ("" for other rows).
static func slider_key(row: String) -> String:
	for sl in AudioMix.SLIDERS:
		if sl[2] == row:
			return sl[0]
	return ""


## Moves a SOUND slider a step and plays a sample through its bus.
func nudge_slider(row: String, d: int) -> void:
	var key := slider_key(row)
	var before := GameManager.volume(key)
	GameManager.nudge_volume(key, d)
	if GameManager.volume(key) == before:
		Sfx.play("error", -10.0)
		return
	var sample: String = SOUND_SAMPLES.get(key, "")
	if sample.begins_with("step_"):
		Sfx.play_step(sample, -8.0)
	elif sample != "":
		Sfx.play(sample, -4.0)
	else:
		Sfx.play("menu_move", -8.0)


## A row of the OPTIONS page as [label, value] ("" for no value; ">" opens a list).
func option_parts(i: int) -> Array:
	var on_off := func(on: bool) -> String: return "ON" if on else "OFF"
	var row := String(options_list()[i])
	if sub_list == "CONTROLS":
		var action := GameManager.remap_label(row)
		if action != "":
			return [row, "PRESS A KEY..." if remap_waiting == action else GameManager.binding_text(action)]
		return ["BACK", "<"] if row == "BACK" else [row, ""]
	match row:
		"GRAPHICS", "SOUND", "CONTROLS", "ONLINE": return [row, ">"]
		"CHARACTER": return [row, Net.NAMES[Net.character]]
		"NAME": return [row, Net.display_name()]
		"ADDRESS": return [row, Net.address]
		"HOST GAME": return [row, ("HOSTING %d" % Net.roster.size()) if Net.is_host else ("JOINED" if Net.active else "")]
		"JOIN GAME": return [row, ""]
		"PVP": return [row, on_off.call(Net.pvp)]
		"LEAVE": return [row, "" if Net.active else "--"]
		"BACK": return ["BACK", "<"]
		"OUTPUT": return [row, "MONO" if GameManager.mono_audio else "STEREO"]
		"PAUSE MUFFLE": return [row, on_off.call(GameManager.pause_muffle)]
		"ANTI-ALIASING": return ["ANTI-ALIAS", on_off.call(GameManager.smoothing)]
		"FOG": return [row, on_off.call(GameManager.fog_enabled)]
		"CROSSHAIR": return [row, on_off.call(GameManager.crosshair)]
		"GUIDING LIGHT": return [row, on_off.call(GameManager.guide_beacon)]
		"FULLSCREEN": return [row, on_off.call(get_window().mode == Window.MODE_FULLSCREEN or get_window().mode == Window.MODE_EXCLUSIVE_FULLSCREEN)]
		"CAMERA": return [row, "MODERN" if GameManager.camera_modern else "CLASSIC"]
		"CAMERA SPEED": return [row, GameManager.CAMERA_SPEED_NAMES[GameManager.camera_speed]]
		"CAMERA X": return [row, "INVERTED" if GameManager.camera_invert_x else "NORMAL"]
		"FRAME RATE": return [row, "21 (OOT)" if GameManager.frame_rate == 21 else str(GameManager.frame_rate)]
		"RESOLUTION": return [row, "240P (N64)" if GameManager.true_n64 else GameManager.RENDER_NAMES[GameManager.render_index]]
		"TRUE N64 MODE": return [row, on_off.call(GameManager.true_n64)]
		"N64 MIPMAPS": return [row, on_off.call(GameManager.n64_mipmaps) if GameManager.true_n64 else "--"]
		"ASPECT RATIO": return [row, "16:9" if GameManager.widescreen else "4:3"]
		"HUD STYLE": return [row, "MODERN" if GameManager.hud_modern else "CLASSIC"]
		"BUTTON ICONS": return [row, Glyphs.FAMILIES[GameManager.glyph_family]]
		"RUMBLE": return [row, on_off.call(GameManager.rumble_enabled)]
		"LOCK-ON": return [row, "HOLD" if GameManager.z_target_hold else "SWITCH"]
		"CAMERA Y": return [row, "INVERTED" if GameManager.invert_look else "NORMAL"]
		"MINIMAP": return [row, on_off.call(GameManager.minimap_enabled)]
	return [row, ""]


## A row as one line of text (label, then value).
func option_text(i: int) -> String:
	var parts := option_parts(i)
	if String(parts[1]) == "":
		return String(parts[0])
	return "%s %s" % parts


## What the name panel shows for the current page's cursor.
func cursor_name() -> String:
	# On a page-turn button: the page it turns to.
	if edge != 0:
		return PAGE_TITLES[(page + (1 if edge > 0 else PAGE_COUNT - 1)) % PAGE_COUNT]
	match page:
		Page.ITEM:
			var item := item_at_cursor()
			return Progress.item_name(item) if item != "" else ""
		Page.EQUIP:
			if equip_cursor.y == UPGRADE_ROW:
				var up := upgrade_info(UPGRADES[equip_cursor.x])
				return String(up.name) if up.owned else ""
			var id := gear_at_cursor()
			if id == "":
				return ""
			match equip_cursor.y:
				0: return Equipment.sword(id).name
				1: return Equipment.shield(id).name
				2: return Equipment.vanity(id).name if Equipment.VANITY.has(id) else Equipment.tunic(id).name
			return Equipment.boots(id).name
		Page.MAP:
			return WorldData.title(map_cursor) if region_seen(map_cursor) else "???"
		Page.JOURNAL:
			var known := Quests.known()
			if journal_cursor < known.size():
				return String(known[journal_cursor].title)
			return ""
		Page.QUEST:
			var slot_name: String = QUEST_SLOTS[quest_cursor][0]
			if BUN_SLOTS.has(quest_cursor):
				var gd: String = BUN_SLOTS[quest_cursor]
				return ("BUN PIECE OF " + Progress.BUN_PIECE_NAMES[gd]) if Progress.has_bun_piece(gd) else "BUN PIECE - ???"
			return slot_name + ("" if quest_cursor >= 5 or Progress.flag(DUNGEON_DONE.get(slot_name, "-")) else " - ???")
	return ""


## The quest tree's rows for the quest under the JOURNAL cursor:
## [state, text] with state "done" (a step ticked off), "now" (the next one),
## "later" (still ahead, its words hidden), or "note" (a list's line).
## A step's text comes as one row per wrapped line; the later lines of a step
## are "+done" / "+now" / "+later".
func tree_rows() -> Array:
	var known := Quests.known()
	if known.is_empty():
		return []
	var q: Dictionary = known[clampi(journal_cursor, 0, known.size() - 1)]
	var out: Array = []
	var add := func(state: String, text: String) -> void:
		var lines := PixelFont.wrap(text, TREE_TEXT_W)
		for i in lines.size():
			out.append([state if i == 0 else "+" + state, lines[i]])
	if q.id == "bestiary":
		for row: Array in Quests.shown_steps(q):
			add.call("note", String(row[0]))
		return out
	var reached := false
	for st: Array in q.steps:
		var ok := Quests.check(String(st[1]))
		if ok:
			add.call("done", String(st[0]))
		elif not reached:
			reached = true
			add.call("now", String(st[0]))
		else:
			add.call("later", "? ? ?")
	# Lists that grow (the kings' epitaphs, the charts' scrawls).
	var extra := Quests.shown_steps(q)
	for i in range(q.steps.size(), extra.size()):
		add.call("note", String(extra[i][0]))
	return out


## A journal entry's NEW mark (Beta 1.6.1): a quest is new until the cursor
## has rested on it with as many steps done as now (each step done brings
## the mark back); the Bestiary, until each new kind has been seen. What has
## been read is kept in the save, as flags "jseen:<quest>:<steps done>".
static func quest_mark(q: Dictionary) -> String:
	var n := Bestiary.count() if q.id == "bestiary" else 0
	if q.id != "bestiary":
		for st: Array in q.steps:
			if Quests.check(String(st[1])):
				n += 1
	return "jseen:%s:%d" % [q.id, n]


static func quest_new(q: Dictionary) -> bool:
	return not Progress.flag(quest_mark(q))


## How much of the game is done, as the file select counts it
## (SaveGame.completion), worked out once a second while the screen is open.
var _pct := 0
var _pct_time := -10.0


func completion_percent() -> int:
	if _blink - _pct_time > 1.0:
		_pct_time = _blink
		_pct = int(SaveGame.completion(Progress.to_dict()).percent)
	return _pct


## Any entry in the journal not read yet.
static func journal_has_new() -> bool:
	for q: Dictionary in Quests.known():
		if quest_new(q):
			return true
	return false


## How far the quest under the cursor has got: [steps done, steps in all].
func quest_progress() -> Vector2i:
	var known := Quests.known()
	if known.is_empty():
		return Vector2i.ZERO
	var q: Dictionary = known[clampi(journal_cursor, 0, known.size() - 1)]
	var n := 0
	for st: Array in q.steps:
		if Quests.check(String(st[1])):
			n += 1
	return Vector2i(n, q.steps.size())


# --- Drawing ------------------------------------------------------------------

func _draw() -> void:
	draw_rect(GameManager.screen_rect(), Color(0, 0, 0, 0.4 * _alpha))
	# Pages, far ones first.
	var order: Array = []
	for i in PAGE_COUNT:
		var c: Vector2 = page_dirs[i] * APOTHEM
		order.append([-(c - _eye).length(), i])
	order.sort()
	for o in order:
		_draw_page(o[1])
	if phase == Phase.OPENING or phase == Phase.CLOSING:
		return
	# Name panel and the Z / R page buttons (OoT's kaleido name panel).
	var name_text := cursor_name()
	var panel := Rect2(80, 196, 160, 16)
	PauseArt.name_panel(self, panel)
	if name_text != "" and phase == Phase.OPEN:
		PixelFont.draw_centered(self, 161, 201, name_text, Color(0, 0, 0, 0.8))
		PixelFont.draw_centered(self, 160, 200, name_text, Color(1, 1, 1))
	# A magic item's cost: a blue pip and the units it takes.
	var cost := Progress.magic_cost(item_at_cursor()) if page == Page.ITEM and phase == Phase.OPEN else 0
	if cost > 0 and Progress.magic_max > 0:
		var mx := panel.end.x + 6.0
		PauseArt.diamond(self, Vector2(mx + 3, panel.get_center().y), 3.0, Color(0.25, 0.55, 1.0))
		# The Looking Glass drains steadily instead (just the pip).
		if item_at_cursor() != "looking_glass":
			PixelFont.draw(self, Vector2(mx + 9, panel.position.y + 4), str(cost), Color(0.6, 0.8, 1.0))
	var pad := GameManager.using_gamepad
	var left_page: int = (page + PAGE_COUNT - 1) % PAGE_COUNT
	var right_page: int = (page + 1) % PAGE_COUNT
	var new_mark := journal_has_new()
	var left_title: String = PAGE_TITLES[left_page] + (" NEW!" if left_page == Page.JOURNAL and new_mark else "")
	var right_title: String = PAGE_TITLES[right_page] + (" NEW!" if right_page == Page.JOURNAL and new_mark else "")
	_page_button(Vector2(8, 196), "LT", left_title, true, edge < 0 and phase == Phase.OPEN)
	_page_button(Vector2(312, 196), "RT", right_title, false, edge > 0 and phase == Phase.OPEN)
	var hint := "{A} DECIDE  {B} SAVE  {START} CLOSE"
	if page == Page.OPTIONS and sound_open and slider_key(options_list()[option_cursor]) != "":
		hint = "{MOVE} VOLUME  {B} BACK" if pad else "{MOVE} VOLUME  {START} BACK"
	elif page == Page.OPTIONS and sub_list != "":
		hint = "{A} DECIDE  {B} BACK" if pad else "{A} DECIDE  {START} BACK"
	if page == Page.ITEM:
		hint = "{X}/{Y} EQUIP  {START} CLOSE"
	if page == Page.EQUIP:
		hint = "{A} EQUIP  {START} CLOSE"
	if page == Page.JOURNAL:
		hint = "{MOVE} CHOOSE  {A} WHOLE QUEST  {START} CLOSE"
	if page == Page.OPTIONS and remap_waiting != "":
		hint = "PRESS THE NEW KEY OR BUTTON"
	if page == Page.MAP and World.floors().size() > 1:
		hint = "{MOVE} FLOOR  {START} CLOSE"
	elif page == Page.MAP:
		hint = "{A} " + ("WORLD MAP" if map_zoom else "AREA MAP") + "  {START} CLOSE"
	if edge != 0:
		hint = "{MOVE} TURN THE PAGE  {B} SAVE  {START} CLOSE"
	if quest_tree:
		hint = "{MOVE} SCROLL  {B} BACK  {START} CLOSE"
	Glyphs.draw_hint(self, 160, 222, hint, Color(0.85, 0.85, 0.9))
	if quest_tree and phase == Phase.OPEN:
		_draw_quest_tree()
	if save_prompt != 0:
		var box := Rect2(80, 84, 160, 50)
		draw_rect(box.grow(2), Color(0.55, 0.45, 0.2, 0.95))
		draw_rect(box, Color(0.04, 0.04, 0.12, 0.95))
		if save_prompt == 2:
			PixelFont.draw_centered(self, 160, 104, "GAME SAVED.", Color(1, 1, 1))
		else:
			PixelFont.draw_centered(self, 160, 94, "WOULD YOU LIKE TO SAVE?", Color(1, 1, 1))
			for i in 2:
				var y := 108 + i * 11
				var sel := save_choice == i
				PixelFont.draw_centered(self, 160, y, ("> %s <" if sel else "%s") % ["YES", "NO"][i], Color(1, 1, 0.6) if sel else Color(0.75, 0.75, 0.85))


## A page-turn button (OoT's L / R arrows beside the name panel); `lit`
## while the cursor stands on it (cursorSpecialPos).
func _page_button(pos: Vector2, button: String, title: String, left: bool, lit := false) -> void:
	var w := Glyphs.badge_width(button) + 6.0
	var x := pos.x if left else pos.x - w
	var box := Rect2(x, pos.y, w, 11)
	draw_rect(box, Color(0.35, 0.55, 1.0, 0.95) if lit else Color(0.15, 0.35, 0.75, 0.9))
	Glyphs.draw_badge(self, Vector2(x + 3, pos.y + 2), button)
	var label := ("< " + title) if left else (title + " >")
	var lx := pos.x if left else pos.x - PixelFont.measure(label).x
	if lit:
		var blink := fmod(_blink, 0.6) < 0.4
		var frame := Rect2(minf(box.position.x, lx) - 3, pos.y - 3, maxf(box.size.x, PixelFont.measure(label).x) + 6, 27)
		draw_rect(frame, Color(1.0, 0.9, 0.3) if blink else Color(0.8, 0.6, 0.15), false, 1.5)
		# The arrow nudging toward the page it turns to.
		var ax := frame.position.x - 5 if left else frame.end.x + 5
		var nudge := sin(_blink * 8.0) * 1.5 * (-1.0 if left else 1.0)
		var dirx := -1.0 if left else 1.0
		draw_colored_polygon(PackedVector2Array([Vector2(ax + nudge + dirx * 4, pos.y + 11), Vector2(ax + nudge, pos.y + 7), Vector2(ax + nudge, pos.y + 15)]), Color(1.0, 0.9, 0.3))
	PixelFont.draw(self, Vector2(lx, pos.y + 14), label, Color(1.0, 0.95, 0.6) if lit else Color(1.0, 0.85, 0.4))


## The JOURNAL's quest tree, drawn flat over the pages (crisp, not on the
## turning drum): the quest's whole line of steps down a vine, those done
## ticked in green, the one to do now glowing gold, those still ahead
## hidden; it scrolls.
func _draw_quest_tree() -> void:
	var known := Quests.known()
	if known.is_empty():
		return
	var q: Dictionary = known[clampi(journal_cursor, 0, known.size() - 1)]
	var panel := Rect2(26, 18, 268, 176)
	draw_rect(Rect2(0, 0, 320, 240).grow(80), Color(0, 0, 0, 0.45))
	draw_rect(panel.grow(3), Color(0.32, 0.2, 0.1))
	draw_rect(panel.grow(2), PauseArt.GOLD)
	draw_rect(panel.grow(1), Color(0.45, 0.32, 0.18))
	draw_rect(panel, Color(0.95, 0.9, 0.77))
	for i in 3:
		draw_rect(Rect2(panel.position.x, panel.position.y + 2 + i, panel.size.x, 1), Color(0.88, 0.8, 0.62, 0.6))
	var ink := Color(0.14, 0.09, 0.05)
	var faded := Color(0.5, 0.4, 0.28)
	var green := Color(0.18, 0.5, 0.16)
	var gold := Color(0.85, 0.55, 0.1)
	# Header: who gave it, the title, and how far along.
	var giver := String(q.giver)
	PixelFont.draw(self, panel.position + Vector2(8, 6), giver, Color(0.6, 0.3, 0.1), 1, false)
	var title := String(q.title)
	PixelFont.draw(self, panel.position + Vector2(8, 17), title, ink, 1, false)
	if q.id != "bestiary":
		var pr := quest_progress()
		var txt := "COMPLETE!" if pr.x >= pr.y else "%d OF %d DONE" % [pr.x, pr.y]
		PixelFont.draw(self, Vector2(panel.end.x - 8 - PixelFont.measure(txt).x, panel.position.y + 6), txt, green if pr.x >= pr.y else faded, 1, false)
	draw_line(Vector2(panel.position.x + 6, panel.position.y + 28), Vector2(panel.end.x - 6, panel.position.y + 28), Color(0.6, 0.45, 0.28, 0.8), 1.0)
	var rows := tree_rows()
	var top := clampi(tree_scroll, 0, maxi(rows.size() - TREE_ROWS, 0))
	var y0 := panel.position.y + 34
	var vine_x := panel.position.x + 14
	# The vine: from the first shown row to the last.
	var shown := mini(TREE_ROWS, rows.size() - top)
	if shown > 0 and q.id != "bestiary":
		draw_line(Vector2(vine_x, y0 + 3), Vector2(vine_x, y0 + (shown - 1) * TREE_ROW_H + 3), Color(0.55, 0.42, 0.25), 1.0)
	for r in shown:
		var row: Array = rows[top + r]
		var state := String(row[0])
		var y := y0 + r * TREE_ROW_H
		var tx := panel.position.x + 24
		var base := state.trim_prefix("+")
		var col := ink
		match base:
			"done":
				col = faded
			"later":
				col = Color(0.6, 0.55, 0.48)
			"now":
				col = ink
		if base == "now":
			draw_rect(Rect2(tx - 3, y - 2, panel.end.x - tx - 6, TREE_ROW_H), Color(1.0, 0.85, 0.35, 0.35))
		if not state.begins_with("+"):
			var c := Vector2(vine_x, y + 3)
			match base:
				"done":
					draw_circle(c, 3.5, green)
					draw_line(c + Vector2(-2, 0), c + Vector2(-0.5, 1.5), Color(1, 1, 1), 1.0)
					draw_line(c + Vector2(-0.5, 1.5), c + Vector2(2, -1.5), Color(1, 1, 1), 1.0)
				"now":
					var pulse := 0.5 + 0.5 * sin(_blink * 5.0)
					draw_circle(c, 4.5, Color(gold, 0.35 + 0.4 * pulse))
					PauseArt.diamond(self, c, 3.5, gold)
				"later":
					draw_circle(c, 3.0, Color(0.6, 0.55, 0.48))
					draw_circle(c, 2.0, Color(0.95, 0.9, 0.77))
				_:
					PauseArt.diamond(self, c, 2.0, Color(0.6, 0.3, 0.1))
		PixelFont.draw_mixed(self, Vector2(tx, y), String(row[1]), col, false)
	# Scroll marks and bar.
	if rows.size() > TREE_ROWS:
		var bar := Rect2(panel.end.x - 6, y0 - 2, 3, TREE_ROWS * TREE_ROW_H)
		draw_rect(bar, Color(0.75, 0.66, 0.5))
		var h := bar.size.y * float(TREE_ROWS) / rows.size()
		var by := bar.position.y + (bar.size.y - h) * float(top) / maxf(rows.size() - TREE_ROWS, 1)
		draw_rect(Rect2(bar.position.x, by, bar.size.x, h), Color(0.5, 0.3, 0.12))


func _draw_page(i: int) -> void:
	var dir3 := Vector3(page_dirs[i].x, 0, page_dirs[i].y)
	var centre := dir3 * APOTHEM
	var normal := -dir3
	var eye3 := Vector3(_eye.x, 0, _eye.y)
	if (eye3 - centre).dot(normal) <= 0.0:
		return
	var right := dir3.cross(Vector3.UP)
	var half := Vector2(HALF_W, HALF_W * PAGE_SIZE.y / PAGE_SIZE.x)
	var fwd := (-eye3).normalized() if eye3.length() > 0.01 else dir3
	var cam_right := fwd.cross(Vector3.UP).normalized()
	var tex := _pages[i].get_texture()
	var tint := Color(1, 1, 1, _alpha)
	# Opening/closing swings everything about the camera's horizontal axis.
	var swing := Basis(cam_right, deg_to_rad(_pitch))
	for gy in GRID.y:
		for gx in GRID.x:
			var poly: Array = []
			for corner in [Vector2(gx, gy), Vector2(gx + 1, gy), Vector2(gx + 1, gy + 1), Vector2(gx, gy + 1)]:
				var u: float = corner.x / GRID.x
				var v: float = corner.y / GRID.y
				var p := centre + right * (u * 2.0 - 1.0) * half.x + Vector3.UP * (1.0 - v * 2.0) * half.y
				p = swing * p
				var rel := p - eye3
				poly.append([Vector3(rel.dot(cam_right), rel.y, rel.dot(fwd)), Vector2(u, v)])
			var clipped := _clip_near(poly, 2.0)
			if clipped.size() < 3:
				continue
			var pts := PackedVector2Array()
			var uvs := PackedVector2Array()
			for q in clipped:
				var c: Vector3 = q[0]
				pts.append(CENTER + Vector2(c.x, -c.y) * FOCAL / c.z)
				uvs.append(q[1])
			draw_polygon(pts, PackedColorArray([tint]), uvs, tex)


## Sutherland-Hodgman clip of a camera-space polygon against z = near.
func _clip_near(poly: Array, near: float) -> Array:
	var out: Array = []
	for k in poly.size():
		var a: Array = poly[k]
		var b: Array = poly[(k + 1) % poly.size()]
		var az: float = a[0].z
		var bz: float = b[0].z
		if az >= near:
			out.append(a)
		if (az >= near) != (bz >= near):
			var t := (near - az) / (bz - az)
			out.append([(a[0] as Vector3).lerp(b[0], t), (a[1] as Vector2).lerp(b[1], t)])
	return out


## One page's flat contents (drawn into its SubViewport).
class PageView extends Control:
	var menu
	var index := 0
	## Area maps, kept referenced so they outlive the draw call that uses them.
	var _maps := {}

	const PANEL := Color(0.08, 0.1, 0.2, 0.86)
	const EDGE := Color(0.55, 0.45, 0.2)
	const TITLE := Color(1.0, 0.85, 0.4)
	const SLOT := Color(0.18, 0.22, 0.36, 0.9)
	const CURSOR := Color(1.0, 0.9, 0.2)

	func _draw() -> void:
		# The carved slate page in its gold frame, and the title banner.
		draw_texture(PauseArt.page_background(Vector2i(size)), Vector2.ZERO)
		var title: String = PAGE_TITLES[index]
		if index == Page.OPTIONS and menu.sub_list != "":
			title = "OPTIONS - " + menu.sub_list
		PauseArt.title_plate(self, size.x * 0.5, 4, title)
		match index:
			Page.ITEM: _draw_items()
			Page.MAP: _draw_map()
			Page.QUEST: _draw_quest()
			Page.JOURNAL: _draw_journal()
			Page.OPTIONS: _draw_options()
			Page.EQUIP: _draw_equipment()

	func _blink() -> bool:
		return fmod(menu._blink, 0.6) < 0.4

	## The cursor stands on this page (not on a page-turn button, nor under
	## the quest tree).
	func _here() -> bool:
		return menu.page == index and menu.edge == 0 and not menu.quest_tree

	func _slot(c: Vector2, radius: float, filled: bool, selected: bool) -> void:
		PauseArt.socket(self, c, radius, filled)
		if selected and _here():
			PauseArt.cursor(self, c, radius + 1.0, menu._blink, CURSOR)

	## The SELECT ITEM page: a tray per section (ARMS, TOOLS, MAGIC, PACK),
	## each named on a plate at its left; the items sit in sockets, the one
	## under the cursor drawn larger, as OoT does, and the ones on X and Y
	## in OoT's gold equipped outline with their button's badge. Items that
	## use magic carry a blue pip; in the PACK a gold rule sets the bottles
	## apart from the Sugar Cube.
	func _draw_items() -> void:
		var active: bool = _here()
		for row in ITEM_ROWS:
			var tray := Rect2(8, ITEM_TRAY_Y + row * ITEM_TRAY_STEP, size.x - 16, ITEM_TRAY_H)
			PauseArt.tray(self, tray)
			var lit: bool = active and menu.item_cursor.y == row
			var label: String = Progress.ITEM_SECTIONS[row] if row < Progress.ITEM_SECTIONS.size() else ""
			PauseArt.label_plate(self, Rect2(tray.position.x + 3, tray.get_center().y - 7, 42, 14), label, lit)
			if label == "PACK":
				var x := ITEM_SLOT_X + 3.5 * ITEM_SLOT_STEP
				draw_line(Vector2(x, tray.position.y + 5), Vector2(x, tray.end.y - 5), Color(PauseArt.GOLD, 0.55), 1.0)
				PauseArt.diamond(self, Vector2(x, tray.get_center().y), 2.0, PauseArt.GOLD)
		for row in ITEM_ROWS:
			for col in ITEM_COLS:
				var c: Vector2 = menu.item_slot_centre(Vector2i(col, row))
				var i := row * ITEM_COLS + col
				var item: String = Progress.ITEM_GRID[i] if i < Progress.ITEM_GRID.size() else ""
				var owned := item != "" and Progress.has_item(item)
				var on_cursor: bool = menu.item_cursor == Vector2i(col, row)
				var button := ""
				for b in ["item_x", "item_y"]:
					if owned and Progress.item_on(b) == item:
						button = "X" if b == "item_x" else "Y"
				if button != "":
					PauseArt.equipped_outline(self, c, ITEM_SLOT_R + 2.0)
				_slot(c, ITEM_SLOT_R, owned, on_cursor)
				if not owned:
					continue
				var side := ITEM_ICON_BIG if on_cursor and active else ITEM_ICON
				HudScreen.draw_icon(self, HudScreen.icon(Progress.icon_id(item)), c, side)
				if Progress.magic_cost(item) > 0:
					PauseArt.diamond(self, c + Vector2(-10, -10), 2.5, Color(0.04, 0.1, 0.3))
					PauseArt.diamond(self, c + Vector2(-10, -10), 1.8, Color(0.35, 0.65, 1.0))
				if Progress.ammo_of(item) >= 0:
					var n := Progress.ammo_of(item)
					var col_n := HudScreen.AMMO_FULL if n >= Progress.ammo_max_of(item) else (Color(1, 1, 1) if n > 0 else Color(0.6, 0.6, 0.6))
					HudScreen.text(self, c + Vector2(-11, 11), str(n), 8, col_n, false)
				if button != "":
					var tw := Glyphs.badge_width(button)
					Glyphs.draw_badge(self, c + Vector2(9 - tw * 0.5, -13), button)
		# The ring that bursts from a slot as its item goes on a button.
		if menu._equip_flash < 0.35 and menu._equip_flash_slot.x >= 0:
			var k: float = menu._equip_flash / 0.35
			var fc: Vector2 = menu.item_slot_centre(menu._equip_flash_slot)
			draw_arc(fc, ITEM_SLOT_R + k * 12.0, 0, TAU, 24, Color(1.0, 0.9, 0.45, 1.0 - k), 2.0)

	## OoT's equipment subscreen, dressed like SELECT ITEM: the hero on the
	## left in a tray of his own, turning to show off his gear, with a short
	## note on the piece under the cursor; on the right a tray per row
	## (SWORDS, SHIELDS, BOOTS) named on its plate, and the UPGRADE tray with
	## each bag's size. The equipped piece of each row sits in the gold
	## equipped outline; empty slots stay dark.
	func _draw_equipment() -> void:
		var active: bool = _here()
		var frame := Rect2(8, EQUIP_TRAY_Y, 68, EQUIP_TRAY_STEP * UPGRADE_ROW + EQUIP_TRAY_H)
		PauseArt.tray(self, frame)
		var portrait: Texture2D = menu._portrait.get_texture() if menu._portrait else null
		if portrait:
			draw_texture_rect(portrait, Rect2(frame.position + Vector2(2, 3), Vector2(64, 96)), false)
		var note: Array = menu.equip_note()
		for i in note.size():
			PixelFont.draw_centered(self, frame.get_center().x, frame.end.y - 30 + i * 11, note[i], PauseArt.LABEL if i == 0 else Color(0.8, 0.82, 0.95))
		for row in UPGRADE_ROW + 1:
			var tray := Rect2(EQUIP_TRAY_X, EQUIP_TRAY_Y + row * EQUIP_TRAY_STEP, size.x - 8 - EQUIP_TRAY_X, EQUIP_TRAY_H)
			PauseArt.tray(self, tray)
			var lit: bool = active and menu.equip_cursor.y == row
			PauseArt.label_plate(self, Rect2(tray.position.x + 3, tray.get_center().y - 7, 45, 14), EQUIP_TITLES[row], lit)
			if row == TUNIC_ROW_INDEX:
				# The vanity outfit sits apart from the tunics, past a gold rule.
				var x: float = (menu.equip_slot_centre(Vector2i(3, row)).x + menu.equip_slot_centre(Vector2i(4, row)).x) * 0.5
				draw_line(Vector2(x, tray.position.y + 4), Vector2(x, tray.end.y - 4), Color(PauseArt.GOLD, 0.55), 1.0)
				PauseArt.diamond(self, Vector2(x, tray.get_center().y), 2.0, PauseArt.GOLD)
		for row in EQUIP_ROWS.size():
			var ids: Array = EQUIP_ROWS[row]
			for col in ids.size():
				var id: String = ids[col]
				var c: Vector2 = menu.equip_slot_centre(Vector2i(col, row))
				var owned: bool = menu.gear_owned(row, id)
				var on_cursor: bool = menu.equip_cursor == Vector2i(col, row)
				if owned and menu.gear_worn(row, id):
					PauseArt.equipped_outline(self, c, EQUIP_SLOT_R + 2.0)
				_slot(c, EQUIP_SLOT_R, owned, on_cursor)
				if owned:
					var look := Equipment.sword_look(id) if row == 0 else id
					HudScreen.draw_icon(self, HudScreen.icon(EQUIP_PREFIX[row] + look), c, 21.0 if on_cursor and active else 17.0)
		for col in UPGRADES.size():
			var c: Vector2 = menu.equip_slot_centre(Vector2i(col, UPGRADE_ROW))
			var up: Dictionary = menu.upgrade_info(UPGRADES[col])
			var on_cursor: bool = menu.equip_cursor == Vector2i(col, UPGRADE_ROW)
			_slot(c, 6.5, up.owned, on_cursor)
			if not up.owned:
				continue
			HudScreen.draw_icon(self, HudScreen.icon(up.icon), c, 15.0 if on_cursor and active else 12.0)
			if up.maxed:
				PauseArt.diamond(self, c + Vector2(5, 5), 1.6, HudScreen.AMMO_FULL)

	func _map_rect() -> Rect2:
		return WORLD_RECT

	func _to_page(grid: Vector2) -> Vector2:
		var m := _map_rect()
		return m.position + Vector2(grid.x / WorldData.MAP_GRID.x * m.size.x, grid.y / WorldData.MAP_GRID.y * m.size.y)

	func _tex(path: String) -> Texture2D:
		if not _maps.has(path):
			_maps[path] = load(path) if ResourceLoader.exists(path) else null
		return _maps[path]

	## OoT's world map page (KaleidoScope_DrawWorldMap): the painted overhead map
	## of the whole land, a dot for every region, the current region's dot
	## pulsing between blue and yellow every 20 frames, the cursor on a dot and
	## its name in the name panel.
	func _draw_map() -> void:
		var m := _map_rect()
		draw_rect(m.grow(2), Color(0.55, 0.45, 0.2))
		draw_rect(m, Color(0.12, 0.2, 0.3, 0.95))
		if World.dungeon_id() != "":
			_draw_dungeon_map(m)
			return
		if menu.map_zoom:
			_draw_area_map(m)
			return
		var tex := _tex(WORLD_MAP)
		if tex:
			draw_texture_rect(tex, m, false)
		var here := WorldData.map_area(World.area_id)
		var pulse := fmod(menu._blink, 2.0) < 1.0
		_draw_fog(m)
		for area: String in WorldData.MAP_LAYOUT:
			if not menu.region_seen(area):
				continue
			var p := _to_page(WorldData.map_point(area)).floor() + Vector2(0.5, 0.5)
			var dot := Color8(0, 0, 255)
			var rim := Color8(255, 255, 0)
			if area == here:
				dot = Color8(255, 255, 0) if pulse else Color8(0, 0, 255)
				rim = Color8(0, 0, 255) if pulse else Color8(255, 255, 0)
			draw_circle(p, 3.5, Color(0, 0, 0, 0.7))
			draw_circle(p, 2.5, rim)
			draw_circle(p, 1.5, dot)
			if area == menu.map_cursor and _here():
				draw_arc(p, 6.0, 0, TAU, 16, CURSOR if _blink() else CURSOR.darkened(0.3), 1.5)
			# The region's Heart Shards: a little heart each, red once found.
			var hs := HeartShards.count(area)
			for k in hs.y:
				var hc := p + Vector2((k - (hs.y - 1) * 0.5) * 6.0, 7.0)
				_tiny_heart(hc, k < hs.x)
		# The Heart Shards of the region under the cursor, spelled out.
		var cnt := HeartShards.count(menu.map_cursor)
		if menu.region_seen(menu.map_cursor):
			var hs_text := ("HEART SHARDS %d / %d" % [cnt.x, cnt.y]) if cnt.y > 0 else "NO HEART SHARDS"
			var hw := PixelFont.measure(hs_text).x + 16
			var hr := Rect2(m.position.x + 2, m.end.y - 13, hw, 11)
			draw_rect(hr, Color(0, 0, 0, 0.55))
			_tiny_heart(hr.position + Vector2(6, 5.5), cnt.y > 0 and cnt.x >= cnt.y)
			PixelFont.draw(self, hr.position + Vector2(12, 2), hs_text, Color(1.0, 0.75, 0.75) if cnt.y > 0 else Color(0.75, 0.75, 0.8))
		# Current position caption, as OoT prints above its map.
		var cap := "NOW: " + WorldData.title(here)
		var w := PixelFont.measure(cap).x + 6
		draw_rect(Rect2(m.position + Vector2(2, 2), Vector2(w, 11)), Color(0, 0, 0, 0.55))
		PixelFont.draw(self, m.position + Vector2(5, 4), cap, Color(0.6, 1.0, 1.0))
		# The time of day (DayNight), with a little sun or moon.
		var clock := DayNight.clock_text(DayNight.hour())
		var cw := PixelFont.measure(clock).x + 16
		var cr := Rect2(m.end.x - cw - 2, m.position.y + 2, cw, 11)
		draw_rect(cr, Color(0, 0, 0, 0.55))
		var night := DayNight.is_night()
		var dot := cr.position + Vector2(6, 5.5)
		if night:
			draw_circle(dot, 3.5, Color(0.9, 0.92, 1.0))
			draw_circle(dot + Vector2(1.6, -1.0), 3.0, Color(0.05, 0.05, 0.1))
		else:
			draw_circle(dot, 3.0, Color(1.0, 0.85, 0.3))
		PixelFont.draw(self, cr.position + Vector2(13, 2), clock, Color(0.75, 0.8, 1.0) if night else Color(1.0, 0.95, 0.7))

	## A small heart (5 px), red when found, a dark outline when not.
	func _tiny_heart(c: Vector2, found: bool) -> void:
		var rows := [".#.#.", "#####", "#####", ".###.", "..#.."]
		var col := Color(0.95, 0.2, 0.25) if found else Color(0.15, 0.1, 0.12, 0.85)
		for y in rows.size():
			for x in 5:
				if (rows[y] as String)[x] == "#":
					draw_rect(Rect2(c.x - 2.5 + x, c.y - 2.5 + y, 1, 1), col)
		if not found:
			draw_rect(Rect2(c.x - 1.5, c.y - 1.5, 1, 1), Color(0.9, 0.5, 0.5, 0.8))

	## The fog of war (Beta 1.6.0): every region the hero has not set foot in
	## lies under a bank of cloud, drifting a little. Each bank is a cluster
	## of puffs laid out the same way every time (seeded by the region's
	## name), shaded under and lit on top.
	func _draw_fog(m: Rect2) -> void:
		var banks: Array = []
		for area: String in WorldData.MAP_LAYOUT:
			if menu.region_seen(area):
				continue
			var gr: Rect2 = WorldData.MAP_LAYOUT[area][0]
			var r := Rect2(_to_page(gr.position), _to_page(gr.end) - _to_page(gr.position)).grow(2.0)
			var rng := RandomNumberGenerator.new()
			rng.seed = hash(area)
			var n := 5 + int(r.get_area() / 55.0)
			var puffs: Array = []
			for k in n:
				var rad := rng.randf_range(5.0, 9.0)
				var c := Vector2(rng.randf_range(r.position.x + 2, r.end.x - 2), rng.randf_range(r.position.y + 2, r.end.y - 2))
				c.x += sin(menu._blink * 0.5 + k * 1.7) * 1.2
				c.x = clampf(c.x, m.position.x + rad, m.end.x - rad)
				c.y = clampf(c.y, m.position.y + rad, m.end.y - rad)
				puffs.append([c, rad])
			banks.append(puffs)
		for puffs: Array in banks:
			for pf: Array in puffs:
				draw_circle(pf[0] + Vector2(0.5, 2.0), pf[1], Color(0.48, 0.52, 0.64, 0.95))
		for puffs: Array in banks:
			for pf: Array in puffs:
				draw_circle(pf[0], pf[1], Color(0.86, 0.88, 0.95))
		for puffs: Array in banks:
			for pf: Array in puffs:
				draw_circle(pf[0] + Vector2(-1.5, -1.5), pf[1] * 0.55, Color(1, 1, 1, 0.75))

	## Inside a dungeon the page shows the dungeon instead (OoT's dungeon map
	## page): its rooms once the Dungeon Map is found, the hero's arrow, and
	## with the Compass the unopened chests (and the boss's lair as a skull).
	func _draw_dungeon_map(m: Rect2) -> void:
		var d := World.dungeon_id()
		var cap := WorldData.title(World.area_id)
		draw_rect(Rect2(m.position + Vector2(2, 2), Vector2(PixelFont.measure(cap).x + 6, 11)), Color(0, 0, 0, 0.55))
		PixelFont.draw(self, m.position + Vector2(5, 4), cap, Color(0.6, 1.0, 1.0))
		var has_map := Progress.has_dungeon_item(d, "map")
		var has_compass := Progress.has_dungeon_item(d, "compass")
		var keys := "KEYS %d" % Progress.keys(d)
		PixelFont.draw(self, m.position + Vector2(5, m.size.y - 11), keys, Color(0.8, 0.9, 1.0))
		var items := ("MAP " if has_map else "") + ("COMPASS " if has_compass else "") + ("BOSS KEY" if Progress.has_dungeon_item(d, "boss_key") else "")
		PixelFont.draw(self, m.position + Vector2(m.size.x - PixelFont.measure(items).x - 5, m.size.y - 11), items, HudScreen.C_YELLOW)
		if not has_map:
			PixelFont.draw_centered(self, m.get_center().x, m.get_center().y - 4, "YOU HAVE NO MAP", Color(0.7, 0.7, 0.8))
			return
		var floors := World.floors()
		var shown: int = clampi(menu.map_floor, 0, maxi(floors.size() - 1, 0))
		var path := "res://assets/textures/world/%s_map.png" % World.area_id
		if floors.size() > 1:
			path = "res://assets/textures/world/%s_map_f%d.png" % [World.area_id, shown]
			_draw_floor_list(m, floors, shown)
		var tex := _tex(path)
		if tex == null or not is_instance_valid(World.area_node):
			return
		var side := minf(m.size.x, m.size.y) - 26
		var r := Rect2(m.get_center() - Vector2(side, side) * 0.5, Vector2(side, side))
		draw_texture_rect(tex, r, false)
		var on_shown := func(n: Node3D) -> bool: return floors.size() <= 1 or World.floor_at(n.global_position.y) == shown
		var rect: Rect2 = World.area_node.get_meta("rect", Rect2())
		var span := maxf(rect.size.x, rect.size.y)
		var origin := rect.get_center() - Vector2(span, span) * 0.5
		var to_page := func(p: Vector3) -> Vector2: return r.position + (Vector2(p.x, p.z) - origin) / span * side
		if has_compass:
			for c in get_tree().get_nodes_in_group("chests"):
				var chest := c as TreasureChest
				if chest and not chest.opened and (chest.visible or chest.appear_flag != "") and on_shown.call(chest):
					var q: Vector2 = to_page.call(chest.global_position)
					draw_rect(Rect2(q - Vector2(2, 2), Vector2(5, 4)), Color(0.9, 0.6, 0.15))
					draw_rect(Rect2(q - Vector2(2, 2), Vector2(5, 1)), Color(1.0, 0.85, 0.3))
			for e in get_tree().get_nodes_in_group("bosses"):
				if on_shown.call(e):
					var q: Vector2 = to_page.call((e as Node3D).global_position)
					draw_circle(q, 3.5, Color(0.9, 0.9, 0.85))
					draw_rect(Rect2(q + Vector2(-2, -1), Vector2(1, 1)), Color.BLACK)
					draw_rect(Rect2(q + Vector2(1, -1), Vector2(1, 1)), Color.BLACK)
		var p := GameManager.player
		if is_instance_valid(p) and on_shown.call(p):
			var c: Vector2 = to_page.call(p.global_position)
			var f := Vector2(-sin(p.facing_yaw), -cos(p.facing_yaw))
			var sd := Vector2(-f.y, f.x)
			var col := Color8(200, 255, 0) if fmod(menu._blink, 0.6) < 0.4 else Color8(255, 255, 255)
			draw_colored_polygon(PackedVector2Array([c + f * 5, c - f * 3 + sd * 3, c - f * 3 - sd * 3]), col)

	## OoT's dungeon floor list down the left of the map: the storey shown is
	## lit, and a little arrow marks the one the hero is on.
	func _draw_floor_list(m: Rect2, floors: Array, shown: int) -> void:
		var here := World.floor_at(GameManager.player.global_position.y) if is_instance_valid(GameManager.player) else -1
		var x := m.position.x + 6
		var y0 := m.get_center().y + floors.size() * 6 - 12
		for i in floors.size():
			var y := y0 - i * 12
			var sel := i == shown
			if sel:
				draw_rect(Rect2(x - 2, y - 2, 20, 11), Color(0.3, 0.3, 0.6, 0.7))
			PixelFont.draw(self, Vector2(x, y), String(floors[i][0]), Color(1, 1, 0.6) if sel else Color(0.6, 0.65, 0.8))
			if i == here:
				draw_colored_polygon(PackedVector2Array([Vector2(x + 19, y + 3), Vector2(x + 24, y), Vector2(x + 24, y + 6)]), Color8(200, 255, 0))

	## The selected area's own map, with the hero's arrow if he is there.
	func _draw_area_map(m: Rect2) -> void:
		var path := "res://assets/textures/world/%s_map.png" % menu.map_cursor
		var tex := _tex(path)
		if tex == null:
			PixelFont.draw_centered(self, size.x * 0.5, 90, "NO MAP", Color(0.7, 0.7, 0.8))
			return
		var side := minf(m.size.x, m.size.y) - 6
		var r := Rect2(m.get_center() - Vector2(side, side) * 0.5, Vector2(side, side))
		draw_texture_rect(tex, r, false)
		if menu.map_cursor == World.area_id and is_instance_valid(GameManager.player) and is_instance_valid(World.area_node):
			var rect: Rect2 = World.area_node.get_meta("rect", Rect2())
			var span := maxf(rect.size.x, rect.size.y)
			var origin := rect.get_center() - Vector2(span, span) * 0.5
			var p := GameManager.player
			var c := r.position + (Vector2(p.global_position.x, p.global_position.z) - origin) / span * side
			var f := Vector2(-sin(p.facing_yaw), -cos(p.facing_yaw))
			var sd := Vector2(-f.y, f.x)
			draw_colored_polygon(PackedVector2Array([c + f * 6, c - f * 4 + sd * 4, c - f * 4 - sd * 4]), Color8(200, 255, 0))

	func _draw_quest() -> void:
		for i in QUEST_SLOTS.size():
			var c: Vector2 = QUEST_SLOTS[i][1]
			var radius := 7.0 if i >= 5 and i < 8 else (16.0 if i == 8 else 11.0)
			# A dungeon's slot fills once its master is beaten.
			var done: bool = i < 5 and Progress.flag(DUNGEON_DONE.get(QUEST_SLOTS[i][0], "-"))
			if BUN_SLOTS.has(i):
				done = Progress.has_bun_piece(BUN_SLOTS[i])
			_slot(c, radius, done, menu.quest_cursor == i)
			if BUN_SLOTS.has(i) and done:
				HudScreen.draw_icon(self, HudScreen.icon("bun_piece_" + BUN_SLOTS[i]), c, 15)
			if i == 8:
				draw_line(c - Vector2(radius, 0), c + Vector2(radius, 0), Color(0.4, 0.45, 0.6), 1.0)
				draw_line(c - Vector2(0, radius), c + Vector2(0, radius), Color(0.4, 0.45, 0.6), 1.0)
		PixelFont.draw_centered(self, 70, 148, "DUNGEONS", Color(0.8, 0.8, 0.9))
		# The Piece of Heart pie fills a quarter per piece (OoT's quest page).
		var pc: Vector2 = QUEST_SLOTS[8][1]
		for q in Progress.heart_pieces:
			var a0 := -PI / 2.0 + q * PI / 2.0
			var pts := PackedVector2Array([pc])
			for s in 7:
				pts.append(pc + Vector2(cos(a0 + s * PI / 12.0), sin(a0 + s * PI / 12.0)) * 15.0)
			draw_colored_polygon(pts, Color(0.95, 0.25, 0.3, 0.9))
		PixelFont.draw_centered(self, 196, 94, "%d / 4" % Progress.heart_pieces, Color(0.8, 0.8, 0.9))
		draw_line(Vector2(140, 22), Vector2(140, 168), Color(0.55, 0.45, 0.2, 0.7), 1.0)
		var hp := GameManager.player.health if is_instance_valid(GameManager.player) else null
		if hp:
			PixelFont.draw_centered(self, 196, 108, "HEARTS %d" % int(ceil(hp.max_health / 2.0)), Color(0.95, 0.5, 0.45))
		PixelFont.draw_centered(self, 196, 119, "BUN PIECES %d/3" % Progress.bun_piece_count(), Color(0.95, 0.85, 0.5))
		# Time played and how much of the game is done (Beta 1.6.1).
		PixelFont.draw_centered(self, 196, 130, "TIME " + Progress.clock_text(Progress.play_time), Color(0.75, 0.85, 1.0))
		var pct: int = menu.completion_percent()
		PixelFont.draw_centered(self, 196, 141, "COMPLETE %d%%" % pct, Color(0.6, 0.95, 0.55))
		var bar := Rect2(160, 151, 72, 4)
		draw_rect(bar, Color(0.12, 0.14, 0.24))
		draw_rect(Rect2(bar.position, Vector2(bar.size.x * pct / 100.0, bar.size.y)), Color(0.4, 0.85, 0.35))
		PixelFont.draw_centered(self, 196, 160, "SIR GIGGLEBUNS IV", Color(0.7, 0.75, 0.9))

	## The hero's journal (redrawn in Beta 1.6.0): parchment, and down the
	## left a scrolling list of quests, each on a tab of its own: the main
	## story's chapters gold with a crown-diamond, errands green-grey, the
	## Bestiary violet, a finished quest faded with a green tick. On the right
	## only the chosen quest: who gave it, its title, what to do now and how
	## far along it is. A opens its whole line of steps (the quest tree).
	## Dark ink on parchment is drawn without the black drop shadow, which
	## smudged it.
	func _draw_journal() -> void:
		var paper := Rect2(8, 20, size.x - 16, size.y - 26)
		draw_rect(paper.grow(1), Color(0.45, 0.32, 0.18))
		draw_rect(paper, Color(0.95, 0.9, 0.77))
		for i in 3:
			draw_rect(Rect2(paper.position.x, paper.position.y + 2 + i, paper.size.x, 1), Color(0.88, 0.8, 0.62, 0.6))
		var known := Quests.known()
		var ink := Color(0.14, 0.09, 0.05)
		var faded := Color(0.48, 0.38, 0.26)
		if known.is_empty():
			PixelFont.draw_centered(self, size.x * 0.5, 90, "NOTHING WRITTEN YET.", faded, 1, false)
			return
		var cur: int = clampi(menu.journal_cursor, 0, known.size() - 1)
		var top: int = menu._journal_scroll
		var list := Rect2(paper.position.x + 3, paper.position.y + 3, 108, JOURNAL_ROWS * JOURNAL_ROW_H)
		var active := _here()
		for r in JOURNAL_ROWS:
			var i := top + r
			if i >= known.size():
				break
			var q: Dictionary = known[i]
			var done := Quests.is_done(q)
			var main: bool = q.kind == Quests.MAIN
			var tab := Rect2(list.position.x, list.position.y + r * JOURNAL_ROW_H, list.size.x - 7, JOURNAL_ROW_H - 2)
			var band := Color(0.85, 0.55, 0.1) if main else Color(0.25, 0.5, 0.42)
			var fill := Color(0.9, 0.76, 0.5) if main else Color(0.78, 0.84, 0.76)
			if q.id == "bestiary":
				band = Color(0.45, 0.3, 0.6)
				fill = Color(0.84, 0.78, 0.88)
			if done:
				band = Color(0.35, 0.55, 0.3)
				fill = Color(0.84, 0.81, 0.74)
			var sel := i == cur
			if sel:
				fill = fill.lightened(0.35)
			draw_rect(tab, fill)
			draw_rect(Rect2(tab.position, Vector2(4, tab.size.y)), band)
			draw_rect(tab, Color(0.5, 0.36, 0.2, 0.9), false, 1.0)
			if sel:
				var glow := Color(1.0, 0.8, 0.2) if (_blink() or not active) else Color(0.8, 0.5, 0.1)
				draw_rect(tab.grow(1), glow if active else Color(0.6, 0.45, 0.2), false, 1.5)
				if active:
					draw_colored_polygon(PackedVector2Array([Vector2(tab.end.x + 1, tab.get_center().y), Vector2(tab.end.x + 5, tab.get_center().y - 3), Vector2(tab.end.x + 5, tab.get_center().y + 3)]), Color(0.75, 0.45, 0.1))
			var icon_c := Vector2(tab.position.x + 10, tab.get_center().y)
			if done:
				draw_line(icon_c + Vector2(-3, 0), icon_c + Vector2(-1, 2), Color(0.2, 0.5, 0.15), 1.5)
				draw_line(icon_c + Vector2(-1, 2), icon_c + Vector2(3, -3), Color(0.2, 0.5, 0.15), 1.5)
			elif main:
				PauseArt.diamond(self, icon_c, 3.0, Color(0.7, 0.4, 0.05))
			else:
				draw_circle(icon_c, 2.5, band)
			var label := String(q.giver if main else q.title)
			var tx := tab.position.x + 16
			var room := tab.end.x - tx - 2
			if menu.quest_new(q):
				# A red NEW badge at the tab's end, until the cursor rests on it.
				var badge := Rect2(tab.end.x - 21, tab.position.y + 3, 19, 9)
				draw_rect(badge, Color(0.8, 0.12, 0.1) if _blink() else Color(0.95, 0.25, 0.15))
				PixelFont.draw(self, badge.position + Vector2(1, 1), "NEW", Color(1, 1, 0.9), 1, false)
				room -= 22
			PixelFont.draw(self, Vector2(tx, tab.position.y + 4), _fit(label, room), faded if done else ink, 1, false)
		# The scroll bar.
		if known.size() > JOURNAL_ROWS:
			var bar := Rect2(list.end.x - 4, list.position.y, 3, list.size.y - 2)
			draw_rect(bar, Color(0.78, 0.68, 0.5))
			var h := bar.size.y * float(JOURNAL_ROWS) / known.size()
			var by := bar.position.y + (bar.size.y - h) * float(top) / maxf(known.size() - JOURNAL_ROWS, 1)
			draw_rect(Rect2(bar.position.x, by, bar.size.x, h), Color(0.5, 0.3, 0.12))
		# The chosen quest, alone.
		var q2: Dictionary = known[cur]
		var x := list.end.x + 6
		var w := paper.end.x - x - 4
		var head := Rect2(x - 2, paper.position.y + 3, w + 4, 12)
		draw_rect(head, Color(0.85, 0.7, 0.42) if q2.kind == Quests.MAIN else Color(0.72, 0.8, 0.72))
		PixelFont.draw(self, head.position + Vector2(3, 3), _fit(String(q2.giver), w - 2), Color(0.35, 0.18, 0.05), 1, false)
		var y2 := head.end.y + 4
		for line in _wrap(String(q2.title), w):
			PixelFont.draw(self, Vector2(x, y2), line, ink, 1, false)
			y2 += 10
		y2 += 3
		draw_line(Vector2(x, y2), Vector2(x + w, y2), Color(0.6, 0.45, 0.28, 0.7), 1.0)
		y2 += 5
		if q2.id == "bestiary":
			PixelFont.draw(self, Vector2(x, y2), "%d KINDS BEATEN" % Bestiary.count(), ink, 1, false)
			y2 += 12
			for l: String in Bestiary.lines().slice(0, 4):
				PixelFont.draw(self, Vector2(x, y2), _fit(l, w), faded, 1, false)
				y2 += 10
		elif Quests.is_done(q2):
			PixelFont.draw(self, Vector2(x, y2), "COMPLETE!", Color(0.2, 0.5, 0.15), 1, false)
			y2 += 12
			PixelFont.draw_mixed(self, Vector2(x, y2), "Every step done.", faded, false)
		else:
			PixelFont.draw(self, Vector2(x, y2), "NOW:", Color(0.7, 0.3, 0.1), 1, false)
			y2 += 11
			for line in PixelFont.wrap(Quests.next_step(String(q2.id)), w):
				PixelFont.draw_mixed(self, Vector2(x, y2), line, ink, false)
				y2 += 10
		# How far along: a bar of steps.
		if q2.id != "bestiary":
			var pr: Vector2i = menu.quest_progress()
			var by2 := paper.end.y - 26
			PixelFont.draw(self, Vector2(x, by2), "%d / %d STEPS" % [pr.x, pr.y], faded, 1, false)
			var bar2 := Rect2(x, by2 + 10, w, 4)
			draw_rect(bar2, Color(0.78, 0.68, 0.5))
			if pr.y > 0:
				draw_rect(Rect2(bar2.position, Vector2(bar2.size.x * pr.x / pr.y, bar2.size.y)), Color(0.3, 0.6, 0.25))

	## Shortens `t` with dots to fit `w` pixels.
	func _fit(t: String, w: float) -> String:
		if PixelFont.measure(t).x <= w:
			return t
		while t.length() > 1 and PixelFont.measure(t + "..").x > w:
			t = t.substr(0, t.length() - 1)
		return t + ".."

	## Breaks `t` into lines no wider than `w` pixels.
	func _wrap(t: String, w: float) -> Array:
		var out: Array = []
		var line := ""
		for word in t.to_upper().split(" "):
			var trial := word if line == "" else line + " " + word
			if PixelFont.measure(trial).x > w and line != "":
				out.append(line)
				line = word
			else:
				line = trial
		if line != "":
			out.append(line)
		return out

	## The OPTIONS page (restyled in Beta 1.6.0): each row a chamfered plate,
	## its name on the left and its setting in a pill on the right (ON in
	## green, OFF in red, a list's arrow), the chosen one lit and outlined in
	## blinking gold, gold rules between the groups; the list scrolls.
	func _draw_options() -> void:
		var rows: Array = menu.options_list()
		var top: int = menu._option_scroll
		var active := _here()
		for r in OPTION_VISIBLE:
			var i := top + r
			if i >= rows.size():
				break
			var y := 22.0 + r * OPTION_ROW
			var plate := Rect2(12, y, 226, OPTION_ROW - 2)
			var sel: bool = menu.option_cursor == i and active
			var chip := PauseArt.chamfer(plate, 3.0)
			draw_colored_polygon(chip, Color(0.24, 0.28, 0.55, 0.96) if sel else Color(0.1, 0.12, 0.24, 0.92))
			var edge_col := (PauseArt.GOLD_LIGHT if _blink() else PauseArt.GOLD) if sel else Color(PauseArt.GOLD_DARK, 0.9)
			for k in chip.size():
				draw_line(chip[k], chip[(k + 1) % chip.size()], edge_col, 1.0)
			PauseArt.diamond(self, Vector2(plate.position.x + 7, plate.get_center().y), 2.5, PauseArt.GOLD_LIGHT if sel else PauseArt.GOLD_DARK.lightened(0.3))
			# Gold rules between the groups of the main list.
			if menu.sub_list == "" and String(rows[i]) in ["RUMBLE", "CREDITS"] and r > 0:
				draw_line(Vector2(30, y - 1.5), Vector2(220, y - 1.5), Color(PauseArt.GOLD, 0.6), 1.0)
			var key: String = menu.slider_key(rows[i])
			if key != "":
				_draw_slider(y + 2, rows[i], key, sel)
				continue
			var parts: Array = menu.option_parts(i)
			var lab_col := Color(1, 1, 0.78) if sel else Color(0.82, 0.84, 0.95)
			PixelFont.draw(self, Vector2(plate.position.x + 14, y + 2), String(parts[0]), lab_col)
			var val := String(parts[1])
			if val == "":
				continue
			var vx := plate.end.x - 6
			if val == ">" or val == "<":
				var cy := plate.get_center().y
				var dx := 1.0 if val == ">" else -1.0
				var ax := vx - 3
				draw_colored_polygon(PackedVector2Array([Vector2(ax + dx * 3, cy), Vector2(ax - dx * 2, cy - 4), Vector2(ax - dx * 2, cy + 4)]), PauseArt.GOLD_LIGHT if sel else PauseArt.GOLD)
				continue
			var vcol := Color(1.0, 0.85, 0.4)
			if val == "ON":
				vcol = Color(0.55, 1.0, 0.55)
			elif val == "OFF":
				vcol = Color(1.0, 0.5, 0.45)
			var vw := PixelFont.measure(val).x
			var pill := Rect2(vx - vw - 6, y + 0.5, vw + 8, OPTION_ROW - 3)
			draw_rect(pill, Color(0, 0, 0, 0.45))
			PixelFont.draw(self, Vector2(vx - vw - 2, y + 2), val, vcol)
		# The scroll bar.
		if rows.size() > OPTION_VISIBLE:
			var bar := Rect2(242, 22, 3, OPTION_VISIBLE * OPTION_ROW - 2)
			draw_rect(bar, Color(0.18, 0.2, 0.34))
			var h := bar.size.y * float(OPTION_VISIBLE) / rows.size()
			var by := bar.position.y + (bar.size.y - h) * float(top) / maxf(rows.size() - OPTION_VISIBLE, 1)
			draw_rect(Rect2(bar.position.x, by, bar.size.x, h), PauseArt.GOLD)
		Glyphs.draw_hint_left(self, Vector2(14, 158), "{MOVE} MOVE  {SELECT} MINIMAP", Color(0.55, 0.55, 0.65))

	## A SOUND row: its name, ten notches (lit up to the volume, gold when
	## selected) and the step as a number (OFF in red at 0).
	func _draw_slider(y: float, label: String, key: String, sel: bool) -> void:
		var v := GameManager.volume(key)
		PixelFont.draw(self, Vector2(26, y), label, Color(1, 1, 0.7) if sel else Color(0.78, 0.78, 0.85))
		var x0 := 118.0
		for i in AudioMix.STEPS:
			var hgt := 3.0 + i * 0.5
			var r := Rect2(x0 + i * 9, y + 7 - hgt, 7, hgt)
			var col := Color(0.25, 0.28, 0.42)
			if i < v:
				col = Color(1.0, 0.85, 0.35) if sel else Color(0.55, 0.75, 1.0)
			draw_rect(r, col)
		var num := "OFF" if v == 0 else str(v)
		var ncol := Color(1, 1, 0.7) if sel else Color(0.78, 0.78, 0.85)
		PixelFont.draw(self, Vector2(x0 + AudioMix.STEPS * 9 + 4, y), num, Color(1.0, 0.45, 0.4) if v == 0 else ncol)
